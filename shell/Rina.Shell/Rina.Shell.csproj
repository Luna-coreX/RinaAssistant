<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- System.Drawing для значка в трее: он рисуется, а не
         берётся из файла в четырёх размерах. -->
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>Rina.Shell</RootNamespace>
    <AssemblyName>Rina.Shell</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rina.Protocol\Rina.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.1" />
  </ItemGroup>
</Project>
