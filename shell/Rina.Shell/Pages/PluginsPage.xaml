<UserControl x:Class="Rina.Shell.Pages.PluginsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{loc:S 'Плагины'}" Style="{StaticResource Text.Title}"
               Margin="0,0,0,16" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="Legend" Text="{loc:S 'УСТАНОВЛЕННЫЕ'}"
                   Style="{StaticResource Text.Section}" Margin="0,0,0,12" />

        <ContentControl x:Name="Empty" Visibility="Collapsed"
                        Margin="0,0,0,12" />

        <Border Style="{StaticResource Rows}">
          <StackPanel x:Name="Items" />
        </Border>

        <!-- Страница плагина: то, что он сам о себе рассказал. -->
        <StackPanel x:Name="PageBox" Margin="0,24,0,0" Visibility="Collapsed">
          <TextBlock x:Name="PageLegend" Style="{StaticResource Text.Section}"
                     Margin="0,0,0,12" />
          <Border Style="{StaticResource Card}">
            <StackPanel x:Name="PageBody" />
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Style="{StaticResource Btn.Primary}"
              Content="{loc:S 'Из папки'}" Click="OnInstallFolder" />
      <Button Style="{StaticResource Btn}" Content="{loc:S 'Из архива'}"
              Click="OnInstallArchive" />
      <Button Style="{StaticResource Btn}" Content="{loc:S 'Обновить'}"
              Click="OnRefresh" />
      <TextBlock x:Name="Note" Style="{StaticResource Text.Meta}"
                 VerticalAlignment="Center" Margin="16,0,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
