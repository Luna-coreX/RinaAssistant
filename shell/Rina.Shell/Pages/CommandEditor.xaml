<!--
  The command editor (4.0-F04, tidied in 4.0b-A09).

  Two columns, not a stack. It was a stack of labels with a field under
  each, every field a different width: the eye had no left edge to run down
  and no right one either, so a form of six rows read as six unrelated
  things. Here the label is always in the same column and the control
  always starts at the same place, which is the rhythm the settings page
  already had — one program, one way of laying out a form.
-->
<UserControl x:Class="Rina.Shell.Pages.CommandEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
             xmlns:ui="clr-namespace:Rina.Shell.Styles"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <UserControl.Resources>
    <!-- One width for every control in the form: the right edge is a line
         a person's eye follows down the card. -->
    <sys:Double x:Key="Wide">300</sys:Double>

    <Style x:Key="FormLabel" TargetType="TextBlock"
           BasedOn="{StaticResource Text.Body}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}" Margin="0,0,0,12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource Col.LegendColumn}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="Legend"
                 Text="{loc:S 'НОВАЯ КОМАНДА'}"
                 Style="{StaticResource Text.Section}" Margin="0,0,0,16" />

      <!-- What to say. There can be several phrases: "start discord" and
           "open discord" are one intent said in different ways. -->
      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="{loc:S 'Фразы, по которым сработает'}"
                 Style="{StaticResource FormLabel}"
                 VerticalAlignment="Top" Margin="0,8,16,0" />
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
        <StackPanel x:Name="Phrases" />
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="NewTrigger" Style="{StaticResource Field}"
                   Width="{StaticResource Wide}"
                   KeyDown="OnTriggerKey"
                   ui:Ui.Hint="{loc:S 'например, «открой почту»'}" />
          <Button Style="{StaticResource Btn}" Content="{loc:S 'Добавить фразу'}"
                  Margin="8,0,0,0" Click="OnAddTrigger" />
        </StackPanel>
      </StackPanel>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:S 'Что сделать'}"
                 Style="{StaticResource FormLabel}" />
      <ComboBox x:Name="Kind" Grid.Row="2" Grid.Column="1"
                Style="{StaticResource Choice}"
                HorizontalAlignment="Left" Width="{StaticResource Wide}"
                Margin="0,0,0,12" SelectionChanged="OnKindChanged" />

      <TextBlock Grid.Row="3" Grid.Column="0" x:Name="TargetLabel"
                 Text="{loc:S 'Что открыть'}"
                 Style="{StaticResource FormLabel}" />
      <StackPanel Grid.Row="3" Grid.Column="1" x:Name="TargetRow"
                  Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="Target" Style="{StaticResource Field}"
                   Width="{StaticResource Wide}" x:FieldModifier="private"
                   TextChanged="OnAnythingChanged" />
          <Button x:Name="Browse" Style="{StaticResource Btn}"
                  Content="{loc:S 'Обзор…'}" Margin="8,0,0,0"
                  Click="OnBrowse" />
        </StackPanel>
        <ComboBox x:Name="Action" Style="{StaticResource Choice}"
                  Width="{StaticResource Wide}"
                  HorizontalAlignment="Left" Visibility="Collapsed" />
      </StackPanel>

      <!-- A sequence: the steps as a list. The order matters — "open the
           browser, then the folder" and the reverse are different commands,
           so the steps move rather than only being added and removed. -->
      <TextBlock Grid.Row="4" Grid.Column="0" x:Name="StepsLabel"
                 Text="{loc:S 'Шаги по порядку'}"
                 Style="{StaticResource FormLabel}"
                 VerticalAlignment="Top" Margin="0,8,16,0"
                 Visibility="Collapsed" />
      <StackPanel Grid.Row="4" Grid.Column="1" x:Name="StepsBox"
                  Margin="0,0,0,12" Visibility="Collapsed">
        <TextBlock x:Name="StepsEmpty" Style="{StaticResource Text.Meta}"
                   Text="{loc:S 'Пока ни одного шага. Добавьте первый — он выполнится первым.'}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel x:Name="Steps" Margin="0,0,0,8" />

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{loc:S 'Новый шаг'}"
                       Style="{StaticResource Text.Section}"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ComboBox x:Name="StepKind" Style="{StaticResource Choice}"
                        Width="200" SelectionChanged="OnStepKindChanged" />
              <TextBox x:Name="StepTarget" Style="{StaticResource Field}"
                       Width="220" Margin="8,0,0,0"
                       ui:Ui.Hint="{loc:S 'что открыть или произнести'}" />
              <ComboBox x:Name="StepAction" Style="{StaticResource Choice}"
                        Width="220" Margin="8,0,0,0"
                        Visibility="Collapsed" />
              <Button x:Name="StepBrowse" Style="{StaticResource Btn}"
                      Content="{loc:S 'Обзор…'}" Margin="8,0,0,0"
                      Click="OnStepBrowse" />
            </StackPanel>
            <Button Style="{StaticResource Btn}" HorizontalAlignment="Left"
                    Content="{loc:S 'Добавить шаг'}" Click="OnAddStep" />
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Grid.Row="5" Grid.Column="0"
                 Text="{loc:S 'Что ответить (необязательно)'}"
                 Style="{StaticResource FormLabel}" />
      <TextBox Grid.Row="5" Grid.Column="1" x:Name="Response"
               Style="{StaticResource Field}" Width="{StaticResource Wide}"
               HorizontalAlignment="Left" Margin="0,0,0,12"
               TextChanged="OnAnythingChanged"
               ui:Ui.Hint="{loc:S 'Рина скажет это вместо «Готово»'}" />

      <TextBlock Grid.Row="6" Grid.Column="1" x:Name="Warning"
                 Style="{StaticResource Text.Meta}"
                 Foreground="{DynamicResource C.Signal}" TextWrapping="Wrap"
                 Visibility="Collapsed" Margin="0,0,0,12" />

      <!--
        The command read back as one thing.

        Everything above is the command in pieces: a phrase here, a kind
        there, a path in a third place. What a person is actually deciding
        is whether the **whole** does what they meant, and until now the
        only way to find that out was to save it and say it out loud. This
        is the same card in a sentence, and it changes as they type.
      -->
      <Border Grid.Row="7" Grid.ColumnSpan="2" x:Name="SummaryBox"
              Style="{StaticResource Rows}" Margin="0,4,0,16" Padding="12">
        <StackPanel>
          <TextBlock Text="{loc:S 'ЧТО ПОЛУЧИТСЯ'}"
                     Style="{StaticResource Text.Section}"
                     Margin="0,0,0,6" />
          <TextBlock x:Name="Summary" Style="{StaticResource Text.Body}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal">
        <Button Style="{StaticResource Btn.Primary}"
                Content="{loc:S 'Сохранить'}" Click="OnSave" />
        <Button Style="{StaticResource Btn}" Content="{loc:S 'Отмена'}"
                Margin="8,0,0,0" Click="OnCancel" />

        <!-- Try it without saving. New, and said to be new right here:
             trying an unsaved command is the one thing in this window whose
             behaviour may still change. -->
        <Button x:Name="Try" Style="{StaticResource Btn}"
                Content="{loc:S 'Проверить'}" Margin="24,0,0,0"
                Click="OnTry" />
        <Border x:Name="TryBeta" Style="{StaticResource Chip.Beta}"
                Margin="6,0,0,0"
                ToolTip="{loc:S 'Бета-возможность: поведение может измениться в следующих версиях.'}">
          <TextBlock Text="{loc:S 'бета'}" Style="{StaticResource Text.Meta}" />
        </Border>

        <TextBlock x:Name="Note" Style="{StaticResource Text.Meta}"
                   VerticalAlignment="Center" Margin="16,0,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
