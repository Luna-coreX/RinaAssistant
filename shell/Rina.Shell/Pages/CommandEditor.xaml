<!--
  The command editor (4.0-F04, made a graph in 4.0b-A09).

  **A command is a graph, always.** A simple one is a graph of a single
  node. There is no "what to do" dropdown any more: it named the command's
  one action, and a command with several actions had to choose "sequence"
  first before it had anywhere to put them. The shape of the thing changed
  depending on how many of it there were, and somebody who started with one
  action and wanted two had to go back and re-declare what they were making.

  Three parts. What is said, along the top. The canvas, where the steps
  stand as nodes with wires between them. And the inspector on the right,
  which shows the selected node and nothing else — a node carries its name
  on the canvas and its details here, so the canvas stays readable at a
  glance and the details stay reachable.
-->
<UserControl x:Class="Rina.Shell.Pages.CommandEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
             xmlns:ui="clr-namespace:Rina.Shell.Styles">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="PageTitle"
               Text="{loc:S 'Новая команда'}"
               Style="{StaticResource Text.Title}" Margin="0,0,0,12" />

    <!-- What is said. Along the top because it is what the whole graph
         hangs from: everything below happens when one of these is heard. -->
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <StackPanel ui:Ui.Gap="{StaticResource Sp.Inner}" Orientation="Horizontal">
        <TextBlock Text="{loc:S 'Фразы, по которым сработает'}"
                   Style="{StaticResource Text.Body}"
                   VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBox x:Name="NewTrigger" Style="{StaticResource Field}"
                 Width="280" KeyDown="OnTriggerKey"
                 ui:Ui.Hint="{loc:S 'например, «открой почту»'}" />
        <Button Style="{StaticResource Btn}" Content="{loc:S 'Добавить фразу'}"
                Margin="8,0,0,0" Click="OnAddTrigger" />
      </StackPanel>
      <WrapPanel x:Name="Phrases" Margin="0,6,0,0" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- The canvas. Nodes and the wires between them; the wires are what
           make it a graph rather than an indented list, because a branch
           that forks is drawn forking. -->
      <Border Grid.Column="0" Style="{StaticResource Rows}"
              Margin="0,0,12,0">
        <!--
          The surface is ruled and has no edges: `Roam` in the code
          beside this.

          A `ScrollViewer` used to be here, and panning moved its
          offsets — which stop at the far side of what is drawn. That
          is a window over a sheet of paper, not a surface: you cannot
          pull the graph to one side to think in the space beside it.
          Now the canvas carries a translation and nothing bounds it;
          the box around it only clips and catches the press, and the
          ruling lives on the box so that it goes on for ever rather
          than ending where the nodes do.
        -->
        <Grid x:Name="Deck" ClipToBounds="True" Background="Transparent">
          <Canvas x:Name="Board" Margin="16"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.RenderTransform>
              <TranslateTransform x:Name="Roaming" />
            </Canvas.RenderTransform>
          </Canvas>
        </Grid>
      </Border>

      <!-- The inspector: the selected node and nothing else. -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Width="300">
        <StackPanel>
          <TextBlock x:Name="PickedTitle" Style="{StaticResource Text.Section}"
                     Text="{loc:S 'НИЧЕГО НЕ ВЫБРАНО'}" Margin="0,0,0,12" />
          <StackPanel x:Name="Picked" />
          <TextBlock x:Name="PickedHint" Style="{StaticResource Text.Meta}"
                     TextWrapping="Wrap"
                     Text="{loc:S 'Выберите узел на холсте, чтобы поправить его.'}" />

          <TextBlock Text="{loc:S 'Что ответить (необязательно)'}"
                     Style="{StaticResource Text.Body}" Margin="0,20,0,6" />
          <TextBox x:Name="Response" Style="{StaticResource Field}"
                   TextChanged="OnAnythingChanged"
                   ui:Ui.Hint="{loc:S 'Рина скажет это вместо «Готово»'}" />

          <TextBlock x:Name="Warning" Style="{StaticResource Text.Meta}"
                     Foreground="{DynamicResource C.Signal}"
                     TextWrapping="Wrap" Visibility="Collapsed"
                     Margin="0,12,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <!--
        The command read back as one sentence. The canvas shows the shape;
        this says what it will do, and the two answer different questions:
        one is "is this the right order", the other "is this the right
        thing".
      -->
      <TextBlock x:Name="Summary" Style="{StaticResource Text.Meta}"
                 TextWrapping="Wrap" Margin="0,0,0,10" />

      <StackPanel ui:Ui.Gap="{StaticResource Sp.Inner}" Orientation="Horizontal">
        <Button Style="{StaticResource Btn.Primary}"
                Content="{loc:S 'Сохранить'}" Click="OnSave" />
        <Button Style="{StaticResource Btn}" Content="{loc:S 'Отмена'}"
                Margin="8,0,0,0" Click="OnCancel" />

        <!-- Try it without saving. New, and said to be new right here:
             trying an unsaved command is the one thing in this window
             whose behaviour may still change. -->
        <Button x:Name="Try" Style="{StaticResource Btn}"
                Content="{loc:S 'Проверить'}" Margin="24,0,0,0"
                Click="OnTry" />
        <Border x:Name="TryBeta" Style="{StaticResource Chip.Beta}"
                Margin="6,0,0,0"
                ToolTip="{loc:S 'Бета-возможность: поведение может измениться в следующих версиях.'}">
          <TextBlock Text="{loc:S 'бета'}" Style="{StaticResource Text.Meta}" />
        </Border>

        <TextBlock x:Name="Note" Style="{StaticResource Text.Meta}"
                   VerticalAlignment="Center" Margin="16,0,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
