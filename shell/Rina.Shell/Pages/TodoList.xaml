<!--
  Things to do (4.0b-A13).

  A panel rather than a window. It was a window at first, and a window takes
  the focus, dims what is behind it and has to be closed; this is laid over
  the home screen and dismissed by clicking beside it. What is behind stays
  visible, so the list reads as something opened on top of the screen rather
  than as another place one has gone to.
-->
<UserControl x:Class="Rina.Shell.Pages.TodoList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{loc:S 'Дела'}"
               Style="{StaticResource Text.Section}" />
    <TextBlock Grid.Row="0" x:Name="Count"
               Style="{StaticResource Text.Meta}"
               HorizontalAlignment="Right" VerticalAlignment="Center" />

    <!-- Adding is possible here too: somebody who opened the list has
         most often come to put something on it. -->
    <Grid Grid.Row="1" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Input" Grid.Column="0"
               Style="{StaticResource Field}"
               KeyDown="OnInputKey" />
      <Button Grid.Column="1" Margin="8,0,0,0"
              Style="{StaticResource Btn}"
              Content="{loc:S 'Записать'}" Click="OnAdd" />
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  MaxHeight="240">
      <StackPanel x:Name="Items" />
    </ScrollViewer>

    <ContentControl Grid.Row="2" x:Name="Empty" Visibility="Collapsed" />

    <CheckBox Grid.Row="3" x:Name="ShowDone" Style="{StaticResource Toggle}"
              Content="{loc:S 'Показывать сделанные'}"
              Margin="0,12,0,0" Click="OnToggleDone" />
  </Grid>
</UserControl>
