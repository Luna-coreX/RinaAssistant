<UserControl x:Class="Rina.Shell.Pages.DialoguePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
             xmlns:ui="clr-namespace:Rina.Shell.Styles">
  <!--
    Dialogue absorbed History (4.0-R04): this is one body of content, and the
    difference between "now" and "yesterday" is scrolling, not a second
    screen.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{loc:S 'Диалог'}" Style="{StaticResource Text.Title}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ExportButton" Style="{StaticResource Btn}"
                Content="{loc:S 'Экспорт'}" Click="OnExport" />
        <Button x:Name="ClearButton" Style="{StaticResource Btn}"
                Content="{loc:S 'Очистить'}" Click="OnClear" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Glass}">
      <Grid>
      <!-- Empty glass explains itself too: a conversation that has not
           happened yet is neither a breakage nor "loading". -->
      <ContentControl x:Name="Empty" Visibility="Collapsed" />

      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" ui:Smooth.Scrolling="True">
        <ItemsControl x:Name="Turns">
          <!--
            A conversation, not a list of lines (4.0b-A12).

            One template with two sides rather than two templates: what
            differs between a person's message and Rina's is where it sits
            and what it sits on, and everything else — the time, the
            wrapping, the states — is the same. Two templates would be two
            places to change whenever a message gains anything.
          -->
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10">
                <Border x:Name="Bubble" MaxWidth="440"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource C.Glass.Raised}"
                        CornerRadius="{StaticResource Radius.Max}"
                        Padding="14,10">
                  <StackPanel>
                    <TextBlock Text="{Binding Said}" TextWrapping="Wrap"
                               Style="{StaticResource Text.Speech}" />
                    <TextBlock x:Name="Stamp" Text="{Binding When}"
                               Style="{StaticResource Text.Meta}"
                               HorizontalAlignment="Right"
                               Margin="12,2,0,0"
                               Foreground="{DynamicResource C.GlassDim}" />
                  </StackPanel>
                </Border>
              </Grid>
              <DataTemplate.Triggers>
                <!-- The person's own words stand on the other side, and on
                     the accent: which of the two is speaking has to be
                     legible without reading a word of it. -->
                <DataTrigger Binding="{Binding Mine}" Value="True">
                  <Setter TargetName="Bubble" Property="HorizontalAlignment"
                          Value="Right" />
                  <Setter TargetName="Bubble" Property="Background"
                          Value="{DynamicResource C.Glass.Control}" />
                </DataTrigger>
                <!-- Thinking: the same bubble, dimmed. Not a spinner —
                     movement here would compete with the figure, which is
                     already saying the same thing. -->
                <DataTrigger Binding="{Binding Pending}" Value="True">
                  <Setter TargetName="Bubble" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <!-- Went wrong: said in the accent rather than in red. There
                     is one accent in the system and it means "attention
                     here" (SYSTEM §6). -->
                <DataTrigger Binding="{Binding Failed}" Value="True">
                  <Setter TargetName="Bubble" Property="BorderBrush"
                          Value="{DynamicResource C.Signal}" />
                  <Setter TargetName="Bubble" Property="BorderThickness"
                          Value="1" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Input" Grid.Column="0" Style="{StaticResource Field}"
               KeyDown="OnInputKey"
               ui:Ui.Hint="{loc:S 'Скажите или напишите: «запусти браузер»'}" />
      <Button x:Name="SendButton" Grid.Column="1" Margin="16,0,0,0"
              Style="{StaticResource Btn.Primary}" Content="{loc:S 'Отправить'}"
              Click="OnSend" />
    </Grid>

    <!--
      "Answer by voice" and "always listen" stand here rather than in
      settings (4.0-R04): these are not a setting but the instrument's mode
      of work, and they are switched in the middle of a conversation.
    -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
      <CheckBox x:Name="VoiceReply" Style="{StaticResource Toggle}"
                Content="{loc:S 'Отвечать голосом'}" Click="OnVoiceReply" />
      <CheckBox x:Name="AlwaysListen" Style="{StaticResource Toggle}"
                Content="{loc:S 'Всегда слушать'}" Margin="32,0,0,0"
                Click="OnAlwaysListen" />
    </StackPanel>
  </Grid>
</UserControl>
