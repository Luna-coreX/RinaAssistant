<UserControl x:Class="Rina.Shell.Pages.DialoguePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
             xmlns:ui="clr-namespace:Rina.Shell.Styles">
  <!--
    Dialogue absorbed History (4.0-R04): this is one body of content, and the
    difference between "now" and "yesterday" is scrolling, not a second
    screen.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{loc:S 'Диалог'}" Style="{StaticResource Text.Title}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ExportButton" Style="{StaticResource Btn}"
                Content="{loc:S 'Экспорт'}" Click="OnExport" />
        <Button x:Name="ClearButton" Style="{StaticResource Btn}"
                Content="{loc:S 'Очистить'}" Click="OnClear" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Glass}">
      <Grid>
      <!-- Empty glass explains itself too: a conversation that has not
           happened yet is neither a breakage nor "loading". -->
      <ContentControl x:Name="Empty" Visibility="Collapsed" />

      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="Turns">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Who}"
                           Style="{StaticResource Text.Figure}"
                           Foreground="{DynamicResource C.GlassDim}" />
                <TextBlock Grid.Column="1" Text="{Binding Said}"
                           Style="{StaticResource Text.Speech}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Input" Grid.Column="0" Style="{StaticResource Field}"
               KeyDown="OnInputKey"
               ui:Ui.Hint="{loc:S 'Скажите или напишите: «запусти браузер»'}" />
      <Button x:Name="SendButton" Grid.Column="1" Margin="16,0,0,0"
              Style="{StaticResource Btn.Primary}" Content="{loc:S 'Отправить'}"
              Click="OnSend" />
    </Grid>

    <!--
      "Answer by voice" and "always listen" stand here rather than in
      settings (4.0-R04): these are not a setting but the instrument's mode
      of work, and they are switched in the middle of a conversation.
    -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
      <CheckBox x:Name="VoiceReply" Style="{StaticResource Toggle}"
                Content="{loc:S 'Отвечать голосом'}" Click="OnVoiceReply" />
      <CheckBox x:Name="AlwaysListen" Style="{StaticResource Toggle}"
                Content="{loc:S 'Всегда слушать'}" Margin="32,0,0,0"
                Click="OnAlwaysListen" />
    </StackPanel>
  </Grid>
</UserControl>
