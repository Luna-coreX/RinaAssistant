<UserControl x:Class="Rina.Shell.Pages.CommandsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{loc:S 'Команды'}" Style="{StaticResource Text.Title}"
               Margin="0,0,0,16" />

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock x:Name="Legend" Text="{loc:S 'МОИ КОМАНДЫ'}"
                 Style="{StaticResource Text.Section}" />
      <TextBlock x:Name="Empty" Margin="0,12,0,0"
                 Text="{loc:S 'Своих команд пока нет.'}"
                 Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                 Foreground="{DynamicResource C.InkSoft}"
                 Visibility="Collapsed" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
      <ContentControl x:Name="EditorBox" />
      <ItemsControl x:Name="Items">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}"
                             Style="{StaticResource Text.Body}" />
                  <TextBlock Text="{Binding What}"
                             Style="{StaticResource Text.Meta}"
                             Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                          IsChecked="{Binding Enabled, Mode=OneWay}"
                          Tag="{Binding Id}" Click="OnToggle"
                          VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="2" Style="{StaticResource Btn}"
                        Content="{loc:S 'Выполнить'}" Tag="{Binding Id}" Click="OnRun" />
                <Button Grid.Column="4" Style="{StaticResource Btn}"
                        Content="{loc:S 'Править'}" Tag="{Binding Id}"
                        Click="OnEdit" />
                <Button Grid.Column="3" Style="{StaticResource Btn}"
                        Content="{loc:S 'Удалить'}" Tag="{Binding Id}" Click="OnDelete" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Что Рина умеет без всяких настроек. У нового человека своих
           команд нет, и без этого раздела страница отвечала бы «пусто» на
           вопрос «а что она вообще умеет». -->
      <StackPanel x:Name="BuiltinBox" Margin="0,24,0,0">
        <TextBlock x:Name="BuiltinLegend" Text="{loc:S 'УМЕЕТ СРАЗУ'}"
                   Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
        <StackPanel x:Name="Builtin" />
      </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Style="{StaticResource Btn.Primary}"
              Content="{loc:S 'Новая команда'}" Click="OnCreate" />
      <Button Style="{StaticResource Btn}" Content="{loc:S 'Импорт'}" Click="OnImport" />
      <Button Style="{StaticResource Btn}" Content="{loc:S 'Экспорт'}" Click="OnExport" />
      <TextBlock x:Name="Note" Style="{StaticResource Text.Meta}"
                 VerticalAlignment="Center" Margin="16,0,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
