<UserControl x:Class="Rina.Shell.Pages.CommandsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Rina.Shell.Styles"
             xmlns:loc="clr-namespace:Rina.Shell.Strings">
  <UserControl.Resources>
    <!-- One row of a command. A resource rather than an inline template:
         every group has a list of its own, and they all draw a row the
         same way. -->
    <DataTemplate x:Key="CommandRow">
      <Border Style="{StaticResource Rows.Item}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource Text.Body}" />
            <TextBlock Text="{Binding What}"
                       Style="{StaticResource Text.Meta}"
                       Margin="0,2,0,0" />
          </StackPanel>
          <CheckBox Grid.Column="1" Style="{StaticResource Toggle}"
                    IsChecked="{Binding Enabled, Mode=OneWay}"
                    Tag="{Binding Id}" Click="OnToggle"
                    VerticalAlignment="Center" Margin="0,0,16,0" />
          <!--
            Run, edit, remove — in that order, and removal last.

            It used to render run · **remove** · edit: the columns were
            declared in a sensible order and numbered in another, so the
            source read "run, edit, delete" while the screen showed the
            destroying one in the middle, between two harmless ones and
            exactly where a slip lands.
          -->
          <Button Grid.Column="2" Style="{StaticResource Btn}"
                  Content="{loc:S 'Выполнить'}" Tag="{Binding Id}"
                  Click="OnRun" />
          <!-- The gap by hand, because these are cells of a grid and
               `Ui.Gap` spaces out the children of a panel. Flush against
               «Выполнить» the two read as one control; measured by
               `check-pages`. -->
          <Button Grid.Column="3" Style="{StaticResource Btn}"
                  Margin="{StaticResource Pad.InnerLeft}"
                  Content="{loc:S 'Править'}" Tag="{Binding Id}"
                  Click="OnEdit" />
          <Button Grid.Column="4" Style="{StaticResource Btn.Danger}"
                  Margin="{StaticResource Pad.DangerLeft}"
                  Content="{loc:S 'Удалить'}" Tag="{Binding Id}"
                  Click="OnDelete" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{loc:S 'Команды'}" Style="{StaticResource Text.Title}"
               Margin="0,0,0,16" />

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock x:Name="Legend" Text="{loc:S 'СВОИ И ВСТРОЕННЫЕ'}"
                 Style="{StaticResource Text.Section}" />
      <ContentControl x:Name="Empty" Margin="0,12,0,0"
                      Visibility="Collapsed" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" x:Name="Scroll" VerticalScrollBarVisibility="Auto" ui:Smooth.Scrolling="True">
      <StackPanel>
      <!--
        The lists, in groups that fold.

        A flat column of every command a person has, with the built-in
        ones piled underneath, answers "what can she do" by making them
        scroll. Grouped, the page answers at a glance and opens out
        where they look. The built-in group starts folded on purpose:
        it is the longest, the least often needed, and the one nobody
        edits.
      -->
      <StackPanel x:Name="Groups" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel ui:Ui.Gap="{StaticResource Sp.Inner}" Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Style="{StaticResource Btn.Primary}"
              Content="{loc:S 'Новая команда'}" Click="OnCreate" />
      <Button Style="{StaticResource Btn}" Content="{loc:S 'Импорт'}" Click="OnImport" />
      <Button Style="{StaticResource Btn}" Content="{loc:S 'Экспорт'}" Click="OnExport" />
      <TextBlock x:Name="Note" Style="{StaticResource Text.Meta}"
                 VerticalAlignment="Center" Margin="16,0,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
