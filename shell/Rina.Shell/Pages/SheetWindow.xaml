<Window x:Class="Rina.Shell.Pages.SheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rina.Shell.Strings"
        Width="620" MaxHeight="720" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!--
    A list that lives in a window of its own (4.0b-A10).

    For what grows: the words Rina answers to, the programs she has learned,
    the key combinations, the models. On a shared page such a thing drowns
    everything below it — after a year of use the settings would be aliases
    with a few switches lost among them.

    The editors inside are the same ones the page builds. What changed is
    where they are shown, not what they are.
  -->
  <Border Background="{DynamicResource C.Face}"
          BorderBrush="{DynamicResource C.Seam}" BorderThickness="1"
          CornerRadius="{StaticResource Radius.Tight}" Padding="28">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,20">
        <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" />
        <TextBlock x:Name="Note" Style="{StaticResource Text.Body}"
                   TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{DynamicResource C.InkSoft}" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Body" />
      </ScrollViewer>

      <Button Grid.Row="2" x:Name="BtnClose" Margin="0,20,0,0"
              HorizontalAlignment="Right" Style="{StaticResource Btn.Primary}"
              Content="{loc:S 'Готово'}" Click="OnClose" IsCancel="True" />
    </Grid>
  </Border>
</Window>
