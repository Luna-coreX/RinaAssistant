<UserControl x:Class="Rina.Shell.Pages.RemindersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
             xmlns:ui="clr-namespace:Rina.Shell.Styles">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{loc:S 'Напоминания'}"
               Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <!-- Завести напоминание можно и голосом; здесь — руками, потому что
           «через двадцать минут» проще выбрать, чем выговорить так, чтобы
           разбор понял с первого раза. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{loc:S 'НОВОЕ НАПОМИНАНИЕ'}"
                     Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="What" Style="{StaticResource Field}" Width="320"
                     ui:Ui.Hint="{loc:S 'о чём напомнить'}" />
            <ComboBox x:Name="When" Style="{StaticResource Choice}" Width="200"
                      Margin="8,0,0,0" />
            <Button Style="{StaticResource Btn.Primary}"
                    Content="{loc:S 'Напомнить'}" Margin="8,0,0,0"
                    Click="OnCreate" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{loc:S 'или ко времени'}"
                       Style="{StaticResource Text.Meta}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="AtTime" Style="{StaticResource Field}" Width="90"
                     ui:Ui.Hint="{loc:S '19:30'}" />
            <TextBlock x:Name="Note" Style="{StaticResource Text.Meta}"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="Legend" Text="{loc:S 'ЗАПЛАНИРОВАНО'}"
                 Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Пустое состояние занимает весь остаток и центрируется в нём:
         прижатое к верху читается как обрезанная страница, а не как
         состояние прибора. -->
    <ContentControl x:Name="Empty" Grid.Row="2" Visibility="Collapsed" />

    <ScrollViewer x:Name="List" Grid.Row="2"
                  VerticalScrollBarVisibility="Auto">
      <Border Style="{StaticResource Rows}">
      <ItemsControl x:Name="Items">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Rows.Item}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Kind}"
                             Style="{StaticResource Text.Body}" />
                  <TextBlock Text="{Binding Text}"
                             Style="{StaticResource Text.Meta}"
                             Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding When}"
                           Style="{StaticResource Text.Figure}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="2" Style="{StaticResource Btn}"
                        Content="{loc:S 'Отменить'}" Tag="{Binding Id}"
                        Click="OnCancel" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
