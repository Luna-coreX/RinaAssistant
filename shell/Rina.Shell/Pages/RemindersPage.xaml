<UserControl x:Class="Rina.Shell.Pages.RemindersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
             xmlns:ui="clr-namespace:Rina.Shell.Styles">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{loc:S 'Напоминания'}"
               Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <!-- A reminder can be set by voice as well; here it is done by hand,
           because "in twenty minutes" is easier to pick than to pronounce in
           a way the parser gets right first time. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{loc:S 'НОВОЕ НАПОМИНАНИЕ'}"
                     Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
          <!-- What to remind about takes the whole width: it is the one
               thing here a person has to write, and the rest is chosen. -->
          <TextBox x:Name="What" Style="{StaticResource Field}"
                   ui:Ui.Hint="{loc:S 'о чём напомнить'}" />

          <!--
            When — the two ways of saying it, on one line and visibly one
            choice.

            They were on separate lines, and the typed time silently won:
            the dropdown went on reading «через 15 минут» while the
            reminder was set for 19:30. Two controls, one of them lying,
            and nothing on the screen to say which. Now the word «или»
            stands between them and whichever is not in use goes quiet.
          -->
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="When" Grid.Column="0"
                      Style="{StaticResource Choice}" Width="200" />
            <TextBlock Grid.Column="1" Text="{loc:S 'или в'}"
                       Style="{StaticResource Text.Meta}"
                       VerticalAlignment="Center" Margin="12,0,12,0" />
            <TextBox x:Name="AtTime" Grid.Column="2"
                     Style="{StaticResource Field}" Width="90"
                     TextChanged="OnAtTimeTyped"
                     ui:Ui.Hint="{loc:S '19:30'}" />
            <TextBlock x:Name="Note" Grid.Column="3"
                       Style="{StaticResource Text.Meta}"
                       VerticalAlignment="Center" Margin="16,0,16,0"
                       TextWrapping="Wrap" />
            <Button Grid.Column="4" Style="{StaticResource Btn.Primary}"
                    Content="{loc:S 'Напомнить'}" Click="OnCreate" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock x:Name="Legend" Text="{loc:S 'ЗАПЛАНИРОВАНО'}"
                 Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
    </StackPanel>

    <!-- The empty state takes up the whole remainder and is centred in it:
         pressed to the top it reads as a page cut short rather than as the
         state of an instrument. -->
    <ContentControl x:Name="Empty" Grid.Row="2" Visibility="Collapsed" />

    <ScrollViewer x:Name="List" Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  ui:Smooth.Scrolling="True">
      <Border Style="{StaticResource Rows}">
      <ItemsControl x:Name="Items">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Rows.Item}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Kind}"
                             Style="{StaticResource Text.Body}" />
                  <TextBlock Text="{Binding Text}"
                             Style="{StaticResource Text.Meta}"
                             Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding When}"
                           Style="{StaticResource Text.Figure}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="2" Style="{StaticResource Btn}"
                        Content="{loc:S 'Отменить'}" Tag="{Binding Id}"
                        Click="OnCancel" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
