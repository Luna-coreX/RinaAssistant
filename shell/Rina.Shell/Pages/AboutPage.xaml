<UserControl x:Class="Rina.Shell.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{loc:S 'О программе'}"
                 Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

      <!-- Кто это. Имя, версия и одна строка о том, что она делает: без
           неё «Рина 4.0.0» ничего не сообщает тому, кто открыл впервые. -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Rina Assistant"
                     Style="{StaticResource Text.Body}" />
          <TextBlock x:Name="Version" Style="{StaticResource Text.Figure}"
                     Margin="0,4,0,8" />
          <TextBlock Style="{StaticResource Text.Meta}" TextWrapping="Wrap"
                     Text="{loc:S 'Голосовой помощник, который живёт на вашем компьютере: слышит, отвечает, запускает программы и напоминает.'}" />
        </StackPanel>
      </Border>

      <!-- Обновления спрашивают здесь: «о программе» — то место, куда
           идут узнать, какая стоит версия, и следующий вопрос всегда
           «а есть ли новее». -->
      <TextBlock Text="{loc:S 'ОБНОВЛЕНИЯ'}"
                 Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="UpdateState" Style="{StaticResource Text.Body}"
                       TextWrapping="Wrap"
                       Text="{loc:S 'Проверка не запускалась.'}" />
            <TextBlock x:Name="UpdateNote" Style="{StaticResource Text.Meta}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <Button x:Name="CheckNow" Grid.Column="1"
                  Style="{StaticResource Btn}"
                  Content="{loc:S 'Проверить'}" Click="OnCheckUpdates"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock Text="{loc:S 'ИЗ ЧЕГО СОБРАНА'}"
                 Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
      <Border Style="{StaticResource Rows}" Margin="0,0,0,16">
        <StackPanel x:Name="Parts" />
      </Border>

      <!-- То, что спрашивают первым делом при разборе неполадки: где
           лежат настройки, журналы и плагины. Без этого человек ищет их
           по проводнику вслепую, а мы — просим прислать то, чего он не
           может найти. -->
      <TextBlock Text="{loc:S 'ГДЕ ЧТО ЛЕЖИТ'}"
                 Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
      <Border Style="{StaticResource Rows}" Margin="0,0,0,16">
        <StackPanel x:Name="Places" />
      </Border>

      <TextBlock Text="{loc:S 'ССЫЛКИ'}"
                 Style="{StaticResource Text.Section}" Margin="0,0,0,12" />
      <StackPanel x:Name="Links" Orientation="Horizontal" Margin="0,0,0,16" />

      <TextBlock x:Name="Note" Style="{StaticResource Text.Meta}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
