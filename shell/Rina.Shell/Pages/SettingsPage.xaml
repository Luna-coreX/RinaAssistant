<UserControl x:Class="Rina.Shell.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings">
  <!--
    Одна длинная панель с прокруткой, а не вложенные вкладки (4.0-R04):
    прибор — это лицевая панель с секциями, а не шкаф с ящиками. При сценарии
    «сеанс за настройкой» видеть соседние секции полезнее, чем прятать их.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{loc:S 'Настройки'}"
               Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

    <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Padding="0,0,12,0">
      <StackPanel x:Name="Body" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
      <!-- Сброс отделён пустотой, а не цветом: между необратимым и
           соседями просвет вдвое больше обычного (DIRECTION §3). -->
      <Button Style="{StaticResource Btn.Danger}" Margin="0,0,64,0"
              Content="{loc:S 'Сбросить настройки'}" Click="OnReset" />
      <TextBlock x:Name="Note" Style="{StaticResource Text.Meta}"
                 VerticalAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
