<!--
  The home screen (4.0b-A07).

  Deliberately almost empty. This is the screen a person looks at rather
  than reads, and everything that arrives here later — the remote for
  whatever is playing, the places plugins put their own things — arrives
  around the figure, not instead of it.

  There is no title here, and that is not an omission. Every other section
  says its name because a person got there by choosing it from a list; this
  one is where they end up without choosing, and a window that announces
  itself on opening is a window that thinks it is a document.
-->
<UserControl x:Class="Rina.Shell.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!--
      The screen itself, in a box of its own, and the box is not
      decoration. The list below is glass, and glass shows what is behind
      it by drawing it again — one brush, one element. Left as loose
      children of the root, the figure, the tiles and the remote were four
      things to draw again; gathered here they are one. A brush cannot be
      pointed at an ancestor of the thing it fills, which is why the list
      stands beside this rather than inside it.
    -->
    <Grid x:Name="Screen">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--
        The figure. A fixed size rather than a stretched one: it is an
        instrument's aperture, and an aperture that changes size with the
        window is a puddle.
      -->
      <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image x:Name="Face" Width="264" Height="264"
               IsHitTestVisible="False" />

        <!--
          There was a machined ring here, and it had to go. A drawn circle
          around a sphere that has its own soft, uneven edge reads as a sphere
          someone has traced round: two edges in the same place, one of them
          perfect, and the perfect one wins the eye. The figure's own rim is
          the edge.
        -->
      </Grid>

      <!--
        What she is doing is said by the figure and by nothing else.

        There was a word under it — "Жду", "Слушаю" — and it went: the figure
        already says this, and a caption repeating it is a second voice
        saying the same thing at the same time.

        **The information did not go with it.** It moved onto the figure
        itself, as an automation name, so a screen reader still says what is
        happening. Removing a caption from the screen and removing it from
        the machinery that reads the screen aloud are different acts, and only
        the first was asked for.
      -->



      <!--
        What plugins asked to show here (4.0b-A07). By ADR 0010 a plugin
        **declares** rather than draws: these are the same elements as on its
        own tab, laid out by us.

        Above the remote and below the figure: the figure is what the screen
        is for, the remote belongs to something that is already happening, and
        a plugin's tile is something to glance at.
      -->
      <ItemsControl x:Name="Tiles" Grid.Row="2"
                    HorizontalAlignment="Center" Margin="0,0,0,16"
                    MaxWidth="440">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!--
        A remote for whatever is already playing (4.0b-A07). Hidden when
        nothing is: an empty panel with three dead buttons says the thing is
        broken, and most of the time nothing is playing.
      -->
      <Border x:Name="Remote" Grid.Row="3" Visibility="Collapsed"
              HorizontalAlignment="Center" Margin="0,0,0,40"
              MaxWidth="420" Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="44" Height="44"
                  CornerRadius="{StaticResource Radius.Tight}"
                  Background="{DynamicResource C.FaceLow}">
            <Image x:Name="Cover" Stretch="UniformToFill" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center"
                      Margin="12,0,12,0">
            <TextBlock x:Name="Track" Style="{StaticResource Text.Body}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Artist" Style="{StaticResource Text.Meta}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button x:Name="Back" Style="{StaticResource Btn.Quiet}"
                    Content="&#x23EE;" Click="OnPrevious"
                    ToolTip="{loc:S 'Предыдущий'}" />
            <Button x:Name="Hold" Style="{StaticResource Btn.Quiet}"
                    Content="&#x23EF;" Click="OnPlayPause"
                    ToolTip="{loc:S 'Пауза'}" />
            <Button x:Name="Ahead" Style="{StaticResource Btn.Quiet}"
                    Content="&#x23ED;" Click="OnNext"
                    ToolTip="{loc:S 'Следующий'}" />
          </StackPanel>
        </Grid>
      </Border>
      <!--
        Things to do (4.0b-A13), in the corner and out of the way.

        Across every row rather than in one: it belongs to the screen, not to
        the column of things on it, and a corner is where a thing one reaches
        for occasionally belongs. An icon and no word — what it opens is
        obvious from what it looks like, and a word here would be the second
        caption removed from this screen today.

        **Out of the room as well** (4.0b-E02). The window gives a page a
        margin of thirty-two, and a corner button inside it sat fifty-two
        points off the glass — in the corner of the page, which is not a
        corner anybody sees. The negative margin steps back out of that room
        and leaves the sixteen the window itself would leave. It reads as an
        exception because it is one: this is the only thing on the screen
        that belongs to the window rather than to the page.
      -->
      <Button x:Name="TodoButton" Grid.RowSpan="4"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,-16,-16" Style="{StaticResource Btn.Corner}"
              Click="OnTodo" Content="&#xE8FD;"
              ToolTip="{loc:S 'Дела'}" />

    </Grid>

    <!--
      The list itself, over the screen rather than in a window of its own.

      It fades in and slides a little, and it is see-through: what is behind
      it stays visible, so the list reads as something laid over the home
      screen rather than as another place one has gone to. A window would
      have taken the focus, dimmed the figure behind it and needed closing;
      this is dismissed by clicking beside it.
    -->
    <Grid x:Name="TodoLayer" Visibility="Collapsed"
          Background="#01000000" MouseLeftButtonDown="OnTodoAway">
      <Border x:Name="TodoPanel" Width="420" MaxHeight="440"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,-16,30"
              BorderBrush="{DynamicResource C.Seam}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Max}"
              MouseLeftButtonDown="OnTodoInside">
        <Border.RenderTransform>
          <TranslateTransform x:Name="TodoRise" />
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="{StaticResource Lift.Overlay.Blur}"
                            ShadowDepth="{StaticResource Lift.Overlay.Y}"
                            Opacity="{StaticResource Lift.Overlay.Opacity}"
                            Direction="270" Color="Black" />
        </Border.Effect>
        <!--
          Glass, not a lid (4.0b-E02). The fill used to be the one a
          drop-down list wears — nine parts in ten — because there was
          nothing underneath it worth seeing. Now what is behind the panel
          is blurred, the way it is behind the title bar, and a blurred
          picture can be read over: half the fill is enough, and the panel
          stops looking like a card dropped onto the screen.

          **Both things behind it, and in the order they stand.** The flow
          first, then the screen's own contents. With only the flow the
          panel was see-through and opaque at once: the background showed
          and the figure it overlapped was cut off at the edge, which reads
          worse than a solid panel because it looks like a mistake.

          Drawn again rather than softened in place: nothing can ask what is
          already painted under it, so glass is two more paintings of what
          is already there. Each needs an element of its own — softening
          belongs to an element, not to a brush — and both hang out past the
          panel and are cut back by the clip, because a blur fades where its
          element ends and the fade showed as a pale rim all the way round.
        -->
        <Grid x:Name="TodoRoom">
          <Rectangle x:Name="TodoGlass" Margin="-24"
                     IsHitTestVisible="False" />
          <Rectangle x:Name="TodoOver" Margin="-24"
                     IsHitTestVisible="False" />
          <Rectangle x:Name="TodoTint" IsHitTestVisible="False"
                     Fill="{DynamicResource C.Glass.Overlay}" />
          <ContentControl x:Name="TodoBody" Margin="20" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
