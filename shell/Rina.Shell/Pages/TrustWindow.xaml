<Window x:Class="Rina.Shell.Pages.TrustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rina.Shell.Strings"
        Title="{loc:S 'Запуск без подписи'}" Width="560"
        SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Topmost="True">
  <Border Background="{DynamicResource C.Face}"
          BorderBrush="{DynamicResource C.Signal}" BorderThickness="2"
          CornerRadius="{StaticResource Radius.Tight}" Padding="24">
    <StackPanel>
      <TextBlock Text="{loc:S 'Эта программа не подписана'}"
                 Style="{StaticResource Text.Title}" Margin="0,0,0,12" />

      <TextBlock Text="{loc:S 'Никто не подтвердил, кто её выпустил и что её не подменяли.'}"
                 Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                 Margin="0,0,0,16" />

      <TextBlock x:Name="AppName" Style="{StaticResource Text.Body}" />
      <TextBlock x:Name="AppPath" Style="{StaticResource Text.Meta}"
                 TextWrapping="Wrap" Margin="0,4,0,4" />
      <TextBlock x:Name="AppSource" Style="{StaticResource Text.Meta}"
                 Margin="0,0,0,20" />

      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Btn}"
                Content="{loc:S 'Запустить один раз'}" Click="OnOnce" />
        <Button Style="{StaticResource Btn}" Margin="8,0,0,0"
                Content="{loc:S 'Всегда доверять'}" Click="OnAlways" />
        <Button Style="{StaticResource Btn.Primary}" Margin="8,0,0,0"
                Content="{loc:S 'Отмена'}" Click="OnNever" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
