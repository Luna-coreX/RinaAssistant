<Window x:Class="Rina.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource Window.Apparatus}"
        Title="Rina Assistant" Width="940" Height="620"
        WindowStartupLocation="CenterScreen">

  <!--
    The window only routes (4.0-F03): it knows about the five sections and
    about where to show them, and nothing about their contents. Pages are
    independent; otherwise the window becomes the very god object that
    block B was started to get rid of.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The title bar: our own, because the typography is our own -->
    <Grid Grid.Row="0" Background="{DynamicResource C.FaceLow}"
          Height="{StaticResource Size.Row}">
      <TextBlock Text="Rina Assistant" VerticalAlignment="Center"
                 Margin="16,0,0,0" FontSize="12" FontWeight="Medium"
                 Foreground="{DynamicResource C.InkSoft}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnMinimise" Style="{StaticResource Btn.Window}"
                Content="&#x2013;" Click="OnMinimise" ToolTip="{loc:S 'Свернуть'}" />
        <Button x:Name="BtnMaximise" Style="{StaticResource Btn.Window}"
                Content="&#x25A2;" Click="OnMaximise" ToolTip="{loc:S 'Развернуть'}" />
        <Button x:Name="BtnClose" Style="{StaticResource Btn.Window}"
                Content="&#x2715;" Click="OnClose" ToolTip="{loc:S 'Закрыть'}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource Col.LegendColumn}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The column of sections: five, in ordinary case, without icons (4.0-R09) -->
      <Grid Grid.Column="0" Background="{DynamicResource C.FaceLow}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Sections" Grid.Row="0" Margin="0,6,0,0" />

        <!-- The foot: the finish, "about", the version and the state of the link -->
        <StackPanel Grid.Row="1" Margin="16,12,16,12">
          <!--
            The state of the link (4.0-F12). It stands next to the version,
            in the foot of the column: this is a note about the instrument,
            not work. Always visible — §13 requires that the window not look
            frozen, and for that a person has to understand what is going on
            without pressing anything.
          -->
          <TextBlock x:Name="CoreStateText" Style="{StaticResource Text.Meta}"
                     Text="{loc:S 'ядро не запускалось'}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock x:Name="FinishSwitch" Style="{StaticResource Text.Meta}"
                       Text="{loc:S 'вид'}" Cursor="Hand"
                       MouseLeftButtonUp="OnSwitchFinish"
                       ToolTip="{loc:S 'Серебро или чёрное'}" />
            <TextBlock Style="{StaticResource Text.Meta}" Text=" · " />
            <TextBlock Style="{StaticResource Text.Meta}" Cursor="Hand"
                       Text="{loc:S 'о программе'}"
                       MouseLeftButtonUp="OnAbout"
                       ToolTip="{loc:S 'Версии, ссылки, из чего собрана'}" />
          </StackPanel>
          <TextBlock x:Name="Version" Style="{StaticResource Text.Figure}"
                     Text="4.0.0" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>

      <!-- The section's contents -->
      <ContentControl x:Name="Pane" Grid.Column="1" Margin="32" />
    </Grid>

    <!--
      The level strip runs along the bottom edge of the whole window rather
      than inside a section: the microphone belongs to the instrument as a
      whole, not to the current screen.
    -->
    <Grid Grid.Row="2" Height="{StaticResource Size.LevelStrip}"
          Background="{DynamicResource C.FaceSunk}">
      <Rectangle x:Name="Level" HorizontalAlignment="Left" Width="0">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="{DynamicResource Color.Signal}" />
            <GradientStop Offset="1" Color="Transparent" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
  </Grid>
</Window>
