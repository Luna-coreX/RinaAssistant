<Window x:Class="Rina.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rina.Shell.Strings"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource Window.Apparatus}"
        Title="Rina Assistant" Width="940" Height="620"
        WindowStartupLocation="CenterScreen">

  <!--
    The window only routes (4.0-F03): it knows about the five sections and
    about where to show them, and nothing about their contents. Pages are
    independent; otherwise the window becomes the very god object that
    block B was started to get rid of.
  -->
  <Grid ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
      The living background, vivid, under the whole window (4.0b-A06).

      Under everything, not only under the working area: the title bar, the
      column and the level strip are glass over it. That is what makes them
      one instrument instead of three planes that happen to touch — and it
      is why this element spans all three rows.

      Empty here: the picture is computed in code from the current finish
      and accent.
    -->
    <Image x:Name="Backdrop" Grid.RowSpan="3" Stretch="Fill"
           IsHitTestVisible="False" />

    <!--
      The same flow, calmed and softened, over the part one reads
      (4.0b-A06). Not a second field: the same one, painted in the calm
      palette and blurred a little. A person reading settings should have
      the background stay behind the words, and the vivid layer is for the
      screen one looks at rather than reads.

      **Across all three rows, like the vivid one** (`4.0b-E01`). It used
      to live inside the working row alone, stretched to that row's
      height — so on every tab but the home screen the top bar showed one
      picture and everything under it another, at another scale, and the
      line between them was the edge of a plate. Measured: eight units of
      brightness across a single point. A person met it as "the bar does
      not belong to the tab", and they were right — it belonged to a
      different background.
    -->
    <Image x:Name="BackdropCalm" Grid.RowSpan="3" Stretch="Fill"
           IsHitTestVisible="False" Visibility="Collapsed" />

    <!--
      The title bar: our own, because the typography is our own.

      **Blurred, and still not a surface** (4.0b-E01). The glasswork keeps
      the bar at a density of zero — it is a place, not a plane, and what
      separates it is typography rather than a fill. Blur is a different
      property: a fill adds a layer, blur takes detail away from the layer
      below. The title stops competing with an eddy of the background, and
      the place stays a place.

      Noticed by the person using it: beside a tab whose content lies on
      glass, a bar with nothing at all read as unfinished.
    -->
    <Grid Grid.Row="0" Background="{DynamicResource C.Glass.Bar}"
          ClipToBounds="True"
          Height="{StaticResource Size.Row}">
      <!--
        The same picture as the background, blurred and clipped to the
        bar. It works because the background is ours: a second view of the
        same bitmap, laid out over the whole window and cut to this row,
        shows exactly what is behind the bar and nothing else.
      -->
      <Image x:Name="BarGlass" Stretch="Fill" VerticalAlignment="Top"
             HorizontalAlignment="Stretch" IsHitTestVisible="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <!--
          Three lines (4.0b-A07). The sections used to stand in a column
          that was always there; now they are behind this, and the window
          gives its whole width to what a person came for.

          Drawn rather than set as a character: the glyphs that look like
          this are not in every font, and a title bar that shows a box
          instead of a button is a title bar with a hole in it.
        -->
        <Button x:Name="BtnMenu" Style="{StaticResource Btn.Window}"
                Click="OnMenu" ToolTip="{loc:S 'Разделы'}"
                Width="{StaticResource Size.Row}">
          <StackPanel VerticalAlignment="Center">
            <Rectangle Width="14" Height="1" Margin="0,2"
                       Fill="{DynamicResource C.InkSoft}" />
            <Rectangle Width="14" Height="1" Margin="0,2"
                       Fill="{DynamicResource C.InkSoft}" />
            <Rectangle Width="14" Height="1" Margin="0,2"
                       Fill="{DynamicResource C.InkSoft}" />
          </StackPanel>
        </Button>
        <TextBlock Text="Rina Assistant" VerticalAlignment="Center"
                   Margin="4,0,0,0" FontSize="12" FontWeight="Medium"
                   Foreground="{DynamicResource C.InkSoft}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnMinimise" Style="{StaticResource Btn.Window}"
                Content="&#x2013;" Click="OnMinimise" ToolTip="{loc:S 'Свернуть'}" />
        <Button x:Name="BtnMaximise" Style="{StaticResource Btn.Window}"
                Content="&#x25A2;" Click="OnMaximise" ToolTip="{loc:S 'Развернуть'}" />
        <Button x:Name="BtnClose" Style="{StaticResource Btn.Window}"
                Content="&#x2715;" Click="OnClose" ToolTip="{loc:S 'Закрыть'}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MenuColumn" Width="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The column of sections: five, in ordinary case, without icons (4.0-R09) -->
      <Grid Grid.Column="0" Background="{DynamicResource C.Glass.Column}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Sections" Grid.Row="0" Margin="0,6,0,0" />

        <!-- The foot: the finish, "about", the version and the state of the link -->
        <StackPanel Grid.Row="1" Margin="16,12,16,12">
          <!--
            The state of the link (4.0-F12). It stands next to the version,
            in the foot of the column: this is a note about the instrument,
            not work. Always visible — §13 requires that the window not look
            frozen, and for that a person has to understand what is going on
            without pressing anything.
          -->
          <TextBlock x:Name="CoreStateText" Style="{StaticResource Text.Meta}"
                     Text="{loc:S 'ядро не запускалось'}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock x:Name="FinishSwitch" Style="{StaticResource Text.Meta}"
                       Text="{loc:S 'вид'}" Cursor="Hand"
                       MouseLeftButtonUp="OnSwitchFinish"
                       ToolTip="{loc:S 'Серебро, чёрное или графит'}" />
            <TextBlock Style="{StaticResource Text.Meta}" Text=" · " />
            <TextBlock Style="{StaticResource Text.Meta}" Cursor="Hand"
                       Text="{loc:S 'о программе'}"
                       MouseLeftButtonUp="OnAbout"
                       ToolTip="{loc:S 'Версии, ссылки, из чего собрана'}" />
          </StackPanel>
          <TextBlock x:Name="Version" Style="{StaticResource Text.Figure}"
                     Text="4.0.0" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>

      <!-- The section's contents -->
      <ContentControl x:Name="Pane" Grid.Column="1" Margin="32" />
    </Grid>

    <!--
      The level strip runs along the bottom edge of the whole window rather
      than inside a section: the microphone belongs to the instrument as a
      whole, not to the current screen.
    -->
    <Grid Grid.Row="2" Height="{StaticResource Size.LevelStrip}"
          Background="{DynamicResource C.Glass.Strip}">
      <Rectangle x:Name="Level" HorizontalAlignment="Left" Width="0">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="{DynamicResource Color.Signal}" />
            <GradientStop Offset="1" Color="Transparent" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
  </Grid>
</Window>
