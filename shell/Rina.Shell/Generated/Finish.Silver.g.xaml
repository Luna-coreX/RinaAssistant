  <SolidColorBrush x:Key="C.FaceHigh" Color="#f0efeb" />
  <Color x:Key="Color.FaceLow">#d8d6d0</Color>
  <SolidColorBrush x:Key="C.FaceLow" Color="#d8d6d0" />
  <Color x:Key="Color.FaceSunk">#cecbc4</Color>
  <SolidColorBrush x:Key="C.FaceSunk" Color="#cecbc4" />
  <Color x:Key="Color.Seam">#c9c6be</Color>
  <SolidColorBrush x:Key="C.Seam" Color="#c9c6be" />
  <Color x:Key="Color.Glass">#17181a</Color>
  <SolidColorBrush x:Key="C.Glass" Color="#17181a" />
  <Color x:Key="Color.GlassText">#eceae5</Color>
  <SolidColorBrush x:Key="C.GlassText" Color="#eceae5" />
  <Color x:Key="Color.GlassDim">#918f88</Color>
  <SolidColorBrush x:Key="C.GlassDim" Color="#918f88" />
  <Color x:Key="Color.Ink">#232220</Color>
  <SolidColorBrush x:Key="C.Ink" Color="#232220" />
  <Color x:Key="Color.InkSoft">#5e5a52</Color>
  <SolidColorBrush x:Key="C.InkSoft" Color="#5e5a52" />
  <Color x:Key="Color.InkFaint">#807b70</Color>
  <SolidColorBrush x:Key="C.InkFaint" Color="#807b70" />
  <Color x:Key="Color.Signal">#b03e16</Color>
  <SolidColorBrush x:Key="C.Signal" Color="#b03e16" />
  <Color x:Key="Color.SignalSunk">#8f3010</Color>
  <SolidColorBrush x:Key="C.SignalSunk" Color="#8f3010" />
  <Color x:Key="Color.Hatch">#232220</Color>
  <SolidColorBrush x:Key="C.Hatch" Color="#232220" />

  <Color x:Key="Color.Shadow">#4a463f</Color>

  <Color x:Key="Color.Nebula0">#e2e7e9</Color>
  <Color x:Key="Color.Nebula1">#e9e2e7</Color>
  <Color x:Key="Color.Nebula2">#e1e8e2</Color>
  <Color x:Key="Color.Nebula3">#eae5df</Color>
  <sys:Int32 x:Key="Nebula.Count">4</sys:Int32>
  <sys:Double x:Key="Nebula.Opacity">0.55</sys:Double>
  <sys:Double x:Key="Nebula.Spread">1.15</sys:Double>
</ResourceDictionary>
