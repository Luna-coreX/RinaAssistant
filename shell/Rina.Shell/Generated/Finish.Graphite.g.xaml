<!-- Отделка «Графит» -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <Color x:Key="Color.Face">#1d2022</Color>
  <SolidColorBrush x:Key="C.Face" Color="#1d2022" />
  <Color x:Key="Color.FaceHigh">#2a2e31</Color>
  <SolidColorBrush x:Key="C.FaceHigh" Color="#2a2e31" />
  <Color x:Key="Color.FaceLow">#16181a</Color>
  <SolidColorBrush x:Key="C.FaceLow" Color="#16181a" />
  <Color x:Key="Color.FaceSunk">#101214</Color>
  <SolidColorBrush x:Key="C.FaceSunk" Color="#101214" />
  <Color x:Key="Color.Seam">#383d41</Color>
  <SolidColorBrush x:Key="C.Seam" Color="#383d41" />
  <Color x:Key="Color.Glass">#0b0d0f</Color>
  <SolidColorBrush x:Key="C.Glass" Color="#0b0d0f" />
  <Color x:Key="Color.GlassText">#e9e8e4</Color>
  <SolidColorBrush x:Key="C.GlassText" Color="#e9e8e4" />
  <Color x:Key="Color.GlassDim">#8b8d8c</Color>
  <SolidColorBrush x:Key="C.GlassDim" Color="#8b8d8c" />
  <Color x:Key="Color.Ink">#dcdbd5</Color>
  <SolidColorBrush x:Key="C.Ink" Color="#dcdbd5" />
  <Color x:Key="Color.InkSoft">#a09f98</Color>
  <SolidColorBrush x:Key="C.InkSoft" Color="#a09f98" />
  <Color x:Key="Color.InkFaint">#7b7a72</Color>
  <SolidColorBrush x:Key="C.InkFaint" Color="#7b7a72" />
  <Color x:Key="Color.Signal">#f2731c</Color>
  <SolidColorBrush x:Key="C.Signal" Color="#f2731c" />
  <Color x:Key="Color.SignalSunk">#cf5c12</Color>
  <SolidColorBrush x:Key="C.SignalSunk" Color="#cf5c12" />
  <Color x:Key="Color.Hatch">#dcdbd5</Color>
  <SolidColorBrush x:Key="C.Hatch" Color="#dcdbd5" />

  <Color x:Key="Color.Shadow">#05070a</Color>

  <Color x:Key="Color.Nebula0">#1d282e</Color>
  <Color x:Key="Color.Nebula1">#26202e</Color>
  <Color x:Key="Color.Nebula2">#1a2b26</Color>
  <Color x:Key="Color.Nebula3">#2a241b</Color>
  <sys:Int32 x:Key="Nebula.Count">4</sys:Int32>
  <sys:Double x:Key="Nebula.Opacity">0.55</sys:Double>
  <sys:Double x:Key="Nebula.Spread">1.15</sys:Double>
</ResourceDictionary>
