<!--
    Порождено из docs/design/tokens.json.
    Не править руками: правьте токены и перезапустите
    python tools/gen_xaml_tokens.py

    Здесь только значения. Стили — решения о том, как выглядит контрол, —
    пишутся и читаются человеком и живут в Styles/.
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Пространство (§4 дизайн-системы) -->
  <sys:Double x:Key="Sp.Hair">1</sys:Double>
  <Thickness x:Key="Pad.Hair">1</Thickness>
  <Thickness x:Key="Pad.HairLeft">1,0,0,0</Thickness>
  <sys:Double x:Key="Sp.Tight">6</sys:Double>
  <Thickness x:Key="Pad.Tight">6</Thickness>
  <Thickness x:Key="Pad.TightLeft">6,0,0,0</Thickness>
  <sys:Double x:Key="Sp.Inner">12</sys:Double>
  <Thickness x:Key="Pad.Inner">12</Thickness>
  <Thickness x:Key="Pad.InnerLeft">12,0,0,0</Thickness>
  <sys:Double x:Key="Sp.Within">16</sys:Double>
  <Thickness x:Key="Pad.Within">16</Thickness>
  <Thickness x:Key="Pad.WithinLeft">16,0,0,0</Thickness>
  <sys:Double x:Key="Sp.Between">32</sys:Double>
  <Thickness x:Key="Pad.Between">32</Thickness>
  <Thickness x:Key="Pad.BetweenLeft">32,0,0,0</Thickness>
  <sys:Double x:Key="Sp.Danger">64</sys:Double>
  <Thickness x:Key="Pad.Danger">64</Thickness>
  <Thickness x:Key="Pad.DangerLeft">64,0,0,0</Thickness>

  <!-- Размеры -->
  <sys:Double x:Key="Size.Row">40</sys:Double>
  <GridLength x:Key="Col.Row">40</GridLength>
  <sys:Double x:Key="Size.Control">36</sys:Double>
  <GridLength x:Key="Col.Control">36</GridLength>
  <sys:Double x:Key="Size.LegendColumn">168</sys:Double>
  <GridLength x:Key="Col.LegendColumn">168</GridLength>
  <sys:Double x:Key="Size.LevelStrip">4</sys:Double>
  <GridLength x:Key="Col.LevelStrip">4</GridLength>
  <sys:Double x:Key="Size.Seam">1</sys:Double>
  <GridLength x:Key="Col.Seam">1</GridLength>

  <!-- Скругление: у приборов углы тугие, не больше 3 -->
  <CornerRadius x:Key="Radius.None">0</CornerRadius>
  <CornerRadius x:Key="Radius.Tight">2</CornerRadius>
  <CornerRadius x:Key="Radius.Max">3</CornerRadius>
  <CornerRadius x:Key="Radius.Window">8</CornerRadius>

  <!-- Гарнитуры -->
  <FontFamily x:Key="Font.Display">Century Gothic, Bahnschrift, Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Cascadia Mono, Consolas</FontFamily>

  <!-- Роли текста (§3): семейство, размер, начертание -->
  <FontFamily x:Key="Type.Title.Family">{StaticResource Font.Display}</FontFamily>
  <sys:Double x:Key="Type.Title.Size">22</sys:Double>
  <FontWeight x:Key="Type.Title.Weight">400</FontWeight>
  <sys:Boolean x:Key="Type.Title.Upper">false</sys:Boolean>
  <FontFamily x:Key="Type.Section.Family">{StaticResource Font.Display}</FontFamily>
  <sys:Double x:Key="Type.Section.Size">11</sys:Double>
  <FontWeight x:Key="Type.Section.Weight">700</FontWeight>
  <sys:Boolean x:Key="Type.Section.Upper">true</sys:Boolean>
  <FontFamily x:Key="Type.Nav.Family">{StaticResource Font.Display}</FontFamily>
  <sys:Double x:Key="Type.Nav.Size">13</sys:Double>
  <FontWeight x:Key="Type.Nav.Weight">400</FontWeight>
  <sys:Boolean x:Key="Type.Nav.Upper">false</sys:Boolean>
  <FontFamily x:Key="Type.Legend.Family">{StaticResource Font.Ui}</FontFamily>
  <sys:Double x:Key="Type.Legend.Size">12</sys:Double>
  <FontWeight x:Key="Type.Legend.Weight">500</FontWeight>
  <sys:Boolean x:Key="Type.Legend.Upper">false</sys:Boolean>
  <FontFamily x:Key="Type.Body.Family">{StaticResource Font.Ui}</FontFamily>
  <sys:Double x:Key="Type.Body.Size">13</sys:Double>
  <FontWeight x:Key="Type.Body.Weight">400</FontWeight>
  <sys:Boolean x:Key="Type.Body.Upper">false</sys:Boolean>
  <FontFamily x:Key="Type.Value.Family">{StaticResource Font.Ui}</FontFamily>
  <sys:Double x:Key="Type.Value.Size">14</sys:Double>
  <FontWeight x:Key="Type.Value.Weight">400</FontWeight>
  <sys:Boolean x:Key="Type.Value.Upper">false</sys:Boolean>
  <FontFamily x:Key="Type.Figure.Family">{StaticResource Font.Mono}</FontFamily>
  <sys:Double x:Key="Type.Figure.Size">13</sys:Double>
  <FontWeight x:Key="Type.Figure.Weight">400</FontWeight>
  <sys:Boolean x:Key="Type.Figure.Upper">false</sys:Boolean>
  <FontFamily x:Key="Type.Speech.Family">{StaticResource Font.Ui}</FontFamily>
  <sys:Double x:Key="Type.Speech.Size">15</sys:Double>
  <FontWeight x:Key="Type.Speech.Weight">400</FontWeight>
  <sys:Double x:Key="Type.Speech.Leading">1.6</sys:Double>
  <sys:Boolean x:Key="Type.Speech.Upper">false</sys:Boolean>
  <FontFamily x:Key="Type.Meta.Family">{StaticResource Font.Ui}</FontFamily>
  <sys:Double x:Key="Type.Meta.Size">11</sys:Double>
  <FontWeight x:Key="Type.Meta.Weight">400</FontWeight>
  <sys:Boolean x:Key="Type.Meta.Upper">false</sys:Boolean>

  <!-- Движение (§7): длительности в миллисекундах -->
  <Duration x:Key="Motion.Instant">0:0:0.000</Duration>
  <Duration x:Key="Motion.Press">0:0:0.090</Duration>
  <Duration x:Key="Motion.State">0:0:0.160</Duration>
  <Duration x:Key="Motion.Panel">0:0:0.220</Duration>
  <Duration x:Key="Motion.Afterglow">0:0:1.000</Duration>

  <!-- Смягчение: cubic-bezier(0.2, 0, 0, 1) для появления, cubic-bezier(0.4, 0, 1, 1) для затухания -->
  <CubicEase x:Key="Ease.In" EasingMode="EaseOut" />
  <CubicEase x:Key="Ease.Out" EasingMode="EaseIn" />

  <!-- Глубина (4.0b-A06): три уровня, дальше человек не различает -->
  <sys:Double x:Key="Lift.Raised.Blur">12</sys:Double>
  <sys:Double x:Key="Lift.Raised.Y">2</sys:Double>
  <sys:Double x:Key="Lift.Raised.Opacity">0.32</sys:Double>
  <sys:Double x:Key="Lift.Floating.Blur">24</sys:Double>
  <sys:Double x:Key="Lift.Floating.Y">5</sys:Double>
  <sys:Double x:Key="Lift.Floating.Opacity">0.4</sys:Double>
  <sys:Double x:Key="Lift.Overlay.Blur">32</sys:Double>
  <sys:Double x:Key="Lift.Overlay.Y">10</sys:Double>
  <sys:Double x:Key="Lift.Overlay.Opacity">0.48</sys:Double>

  <!-- Стекло (4.0b-A06): сквозь полосы и органы управления видно течение -->
  <sys:Double x:Key="Glass.Bar">0.0</sys:Double>
  <sys:Double x:Key="Glass.Column">0.0</sys:Double>
  <sys:Double x:Key="Glass.Strip">0.62</sys:Double>
  <sys:Double x:Key="Glass.Field">0.95</sys:Double>
  <sys:Double x:Key="Glass.Control">0.55</sys:Double>
  <sys:Double x:Key="Glass.Raised">0.5</sys:Double>
  <sys:Double x:Key="Glass.Edge">0.14</sys:Double>
  <sys:Double x:Key="Glass.Popup">0.9</sys:Double>
  <sys:Double x:Key="Glass.Overlay">0.5</sys:Double>
  <sys:Double x:Key="Glass.Blur">18.0</sys:Double>

  <!-- Дыхание фона (4.0b-A06). Когда фон замирает, решает оболочка, а не эти числа -->
  <sys:Double x:Key="Background.Period">9</sys:Double>
  <sys:Double x:Key="Background.Fps">60</sys:Double>
  <sys:Double x:Key="Background.Drift">3.0</sys:Double>

  <!-- Штриховка опасного (§6): единственный признак необратимого -->
  <sys:Double x:Key="Hatch.Angle">45</sys:Double>
  <sys:Double x:Key="Hatch.Line">2</sys:Double>
  <sys:Double x:Key="Hatch.Gap">7</sys:Double>
  <sys:Double x:Key="Hatch.Opacity">0.2</sys:Double>
</ResourceDictionary>
