<!--
  Органы управления. Написаны, а не взяты из библиотеки — ADR 0005.

  Второстепенная кнопка не нарисована коробкой: она заподлицо с панелью и
  проявляется при наведении. Заметность даёт единственная первичная кнопка,
  залитая чернилами, — иерархия без второго акцента. Акцент в системе один,
  и означает он «здесь внимание», а не «это важная кнопка».

  Теней нет нигде. Возвышение выражается ступенью значения и волосяным швом:
  у приборной панели нет источника света, и тень имитировала бы то, чего
  не существует.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ui="clr-namespace:Rina.Shell.Styles"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <!--
              Слой подсветки поверх лица. Анимируется его прозрачность, а
              не цвет кисти: кисти из словаря общие и заморожены, и
              анимация цвета уронила бы приложение на первом наведении.
            -->
            <Border x:Name="Face" Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource Radius.Max}" />
            <Border x:Name="Warm" Opacity="0"
                    Background="{DynamicResource C.FaceHigh}"
                    CornerRadius="{StaticResource Radius.Max}" />
            <Border x:Name="Sunk" Opacity="0"
                    Background="{DynamicResource C.FaceLow}"
                    CornerRadius="{StaticResource Radius.Max}" />
            <Border x:Name="Ring" BorderThickness="0"
                    CornerRadius="{StaticResource Radius.Max}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Наведение — смена состояния: 160 мс (SYSTEM §7). -->
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Warm"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Warm"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- Нажатие — отклик: 90 мс. Быстрее наведения нарочно: палец
                 уже нажал, и ждать от прибора нечего. -->
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sunk"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.Press}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sunk"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.Press}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- Фокус рамкой, а не подсветкой фона: пользователь клавиатуры
                 должен видеть, где он, не гадая, выделено это или наведено. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush"
                      Value="{DynamicResource C.Signal}" />
              <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource C.InkFaint}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Штриховка необратимого. Единственный признак опасности в системе, и
    встречается ровно в одном месте — потому и значит всегда одно и то же.

    Цветом опасность не обозначается: он размывается от повторения, и там,
    где красным красят каждую неприятность, красный перестаёт значить
    «осторожно». Красного в палитре нет вовсе.

    Угол, толщина, шаг и прозрачность — из tokens.json.
  -->
  <DrawingBrush x:Key="Hatch" TileMode="Tile" Stretch="None"
                Viewport="0,0,7,7" ViewportUnits="Absolute"
                Opacity="0.2">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Pen>
          <Pen Brush="{DynamicResource C.Hatch}" Thickness="2" />
        </GeometryDrawing.Pen>
        <GeometryDrawing.Geometry>
          <LineGeometry StartPoint="0,7" EndPoint="7,0" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!--
    Кнопка необратимого действия. Не залита акцентом и не красная: она
    заштрихована. Второе средство — просвет вокруг неё, вдвое больше
    обычного; оно работает и для того, кто узора не различает.
  -->
  <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource Hatch}" />
    <Setter Property="Padding" Value="20,0" />
  </Style>

  <!-- Первичная: одна на экран. Залита чернилами, а не акцентом. -->
  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource C.Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource C.Face}" />
  </Style>

  <!-- Управление окном: знаки, а не слова. Это соглашение системы. -->
  <Style x:Key="Btn.Window" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="{StaticResource Size.Row}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource C.InkFaint}" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
  </Style>

  <!-- Раздел в колонке. Отметка активного — единственный акцент. -->
  <Style x:Key="Nav.Item" TargetType="RadioButton">
    <Setter Property="Height" Value="{StaticResource Size.Row}" />
    <Setter Property="Foreground" Value="{DynamicResource C.InkSoft}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Nav.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource Type.Nav.Weight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Row" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Подсветка наведения — отдельным слоем: цвет общей кисти
                 анимировать нельзя, она заморожена. -->
            <Border x:Name="Warm" Grid.ColumnSpan="2" Opacity="0"
                    Background="{DynamicResource C.FaceHigh}" />
            <Rectangle x:Name="Mark" Grid.Column="0" Fill="Transparent" />
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                              Margin="14,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Warm"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Warm"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Row" Property="Background"
                      Value="{DynamicResource C.Face}" />
              <Setter TargetName="Mark" Property="Fill"
                      Value="{DynamicResource C.Signal}" />
              <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Поле: утоплено, без рамки. Граница нарисована ступенью значения. -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource C.FaceSunk}" />
    <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource C.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Well" Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Radius.Max}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <!-- Подсказка под содержимым: она гаснет, как только в поле
                   появляется текст, и никогда не становится значением. -->
              <TextBlock x:Name="Hint" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Foreground="{DynamicResource C.InkFaint}"
                         FontFamily="{StaticResource Font.Ui}"
                         FontSize="{StaticResource Type.Value.Size}"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Path=(ui:Ui.Hint),
                                RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Text.Length,
                           RelativeSource={RelativeSource Self}}" Value="0" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Hint" Property="Visibility"
                      Value="Visible" />
            </MultiDataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Well" Property="BorderBrush"
                      Value="{DynamicResource C.Signal}" />
              <Setter TargetName="Well" Property="BorderThickness" Value="2" />
              <Setter TargetName="Well" Property="Padding" Value="10,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Переключатель. Включённое положение — отметка акцентом: это состояние
    «выбрано» из таблицы §6, а не второй смысл акцента.
  -->
  <!--
    Выпадающий список.

    Своего стиля у него не было, и WPF рисовал свой: белое поле с синей
    рамкой посреди чёрной отделки. Это ровно тот случай, ради которого
    ADR 0005 отказался от чужой библиотеки в пользу своих стилей поверх
    стандартных контролов, — и напоминание, что «стандартный контрол»
    значит «выглядит стандартно», пока его не одеть.

    Недоступный вариант гаснет, но остаётся: человек должен видеть, что
    такой движок бывает, — иначе он будет искать его там, где мы его
    спрятали.
  -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Row" Background="Transparent"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Row" Property="Background"
                      Value="{DynamicResource C.FaceHigh}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground"
                      Value="{DynamicResource C.InkFaint}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Ползунок.

    Заводится там, где ядро назвало **обе** границы: «громкость от нуля до
    ста» — это приглашение тянуть, а не набирать. Правило общее, а не
    список ключей: настройка, у которой появятся границы, получит ползунок
    сама, и никто не забудет её сюда вписать.

    Значение показано рядом всегда. Ползунок без числа отвечает на вопрос
    «примерно сколько», а на «ровно сколько» не отвечает — и человек,
    которому надо выставить восемьдесят, обречён возить мышью.
  -->
  <Style x:Key="Slide" TargetType="Slider">
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <!-- Дорожка утоплена, пройденное — акцентом: «сколько уже» и
                 «сколько всего» должны различаться без подписи. -->
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource C.FaceSunk}" />
            <Border x:Name="PART_SelectionRange" Height="4" CornerRadius="2"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource C.Signal}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge"
                              Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge"
                              Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="16" Height="16">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="Grip"
                               Fill="{DynamicResource C.Ink}" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Grip" Property="Fill"
                                  Value="{DynamicResource C.Signal}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Grip" Property="Fill"
                                  Value="{DynamicResource C.Signal}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Choice" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource C.FaceSunk}" />
    <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Face" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Well"
                          Background="{DynamicResource C.FaceSunk}"
                          CornerRadius="{StaticResource Radius.Max}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0" Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                      <!-- Стрелка нарисована, а не набрана символом: шрифт
                           может её не содержать, и тогда список выглядел бы
                           сломанным на чужой машине. -->
                      <Path Grid.Column="1" Margin="8,0,14,0"
                            VerticalAlignment="Center"
                            Data="M0,0 L8,0 L4,5 Z"
                            Fill="{DynamicResource C.InkSoft}" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Well" Property="Background"
                              Value="{DynamicResource C.FaceLow}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="Shown" IsHitTestVisible="False"
                              Margin="12,0,34,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />

            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                   Placement="Bottom" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   PopupAnimation="Fade">
              <!-- Приподнятая поверхность, а не утопленная: список лежит
                   поверх панели. Заодно это единственная подложка, на
                   которой погашенный вариант читается в обеих отделках
                   (2.90 против нужных 3.0 на утопленной в «серебре»). -->
              <Border Background="{DynamicResource C.FaceHigh}"
                      BorderBrush="{DynamicResource C.Seam}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Tight}"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="320" Margin="0,4,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Shown" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <!-- Подпись у органа управления обязательна (направление), и цвет ей
         даёт система, а не умолчание WPF: иначе она окажется той серой,
         которую никто не выбирал. -->
    <Setter Property="Foreground" Value="{DynamicResource C.InkSoft}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <!-- Тумблер, а не пилюля. Радиус 11 делал из него кнопку
                 телефона; у приборов углы тугие, и предел радиуса — 3
                 (DIRECTION §2). Заодно так он честнее: это переключатель
                 на панели, а не мягкий значок в списке. -->
            <Grid Width="40" Height="22" VerticalAlignment="Center">
              <Border x:Name="Track"
                      CornerRadius="{StaticResource Radius.Max}"
                      Background="{DynamicResource C.FaceSunk}" />
              <!-- Включённое положение — отдельным слоем поверх: цвет
                   общей кисти анимировать нельзя, она заморожена. -->
              <Border x:Name="On" Opacity="0"
                      CornerRadius="{StaticResource Radius.Max}"
                      Background="{DynamicResource C.Signal}" />
              <!--
                Бегунок ездит сдвигом, а не сменой выравнивания:
                выравнивание переключается мгновенно, а состояние в системе
                меняется за 160 мс (SYSTEM §7). Тумблер, у которого
                бегунок телепортируется, читается как картинка, а не как
                орган управления.
              -->
              <Border x:Name="Knob" Width="14" Height="14"
                      CornerRadius="{StaticResource Radius.Tight}"
                      HorizontalAlignment="Left" Margin="4,0,0,0"
                      Background="{DynamicResource C.InkFaint}">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="Shift" X="0" />
                </Border.RenderTransform>
              </Border>
            </Grid>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Knob" Property="Background"
                      Value="{DynamicResource C.FaceHigh}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <!-- 40 ширина дорожки − 14 бегунок − 4 отступ слева
                         − 4 справа = 18 точек хода. -->
                    <DoubleAnimation Storyboard.TargetName="Shift"
                                     Storyboard.TargetProperty="X"
                                     To="18"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                    <DoubleAnimation Storyboard.TargetName="On"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shift"
                                     Storyboard.TargetProperty="X"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                    <DoubleAnimation Storyboard.TargetName="On"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Стеклянное поле: единственная светящаяся поверхность прибора. -->
  <Style x:Key="Glass" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource C.Glass}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Max}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!--
    Полоса прокрутки. Своя, потому что стоковая приносит палитру Windows на
    панель, у которой она своя, — и в чёрной отделке светло-серая полоса
    видна первой, раньше содержимого.

    Без стрелок: они принадлежат другому времени и занимают место, ничего не
    добавляя. Ползунок — ступень значения, как и всё возвышение в системе.
  -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="{DynamicResource C.InkFaint}"
                  CornerRadius="{StaticResource Radius.Max}" Opacity="0.5" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" />
            </Track.Thumb>
            <!-- Кнопки страницы обязаны существовать, но видимыми им быть
                 незачем: полоса и есть орган управления. -->
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand"
                            Opacity="0" Focusable="False" />
            </Track.IncreaseRepeatButton>
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand"
                            Opacity="0" Focusable="False" />
            </Track.DecreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Карточка: приподнята ступенью значения, без рамки и без тени. -->
  <!--
    Блок списка: одна приподнятая ступень на весь список.

    Не стопка карточек: «окно — это лицевая панель, а не набор карточек на
    фоне» (DIRECTION §3). Строки списка — части одного предмета, и зазор
    между ними превращал бы их в пять предметов.
  -->
  <Style x:Key="Rows" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource C.FaceHigh}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Max}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!--
    Строка внутри блока. Отделена от соседней волосяным швом — тем же
    средством, что и области панели, и никогда тенью.
  -->
  <!--
    Своя кисть каждой строке.

    `x:Shared="False"` обязателен: значение из словаря иначе одно на всех,
    и оно заморожено — анимировать его нельзя, а если бы было можно,
    подсветилась бы разом вся таблица. Одна строка — одна кисть.
  -->
  <SolidColorBrush x:Key="Row.Warm" x:Shared="False" Opacity="0"
                   Color="{DynamicResource Color.FaceLow}" />

  <Style x:Key="Rows.Item" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Row.Warm}" />
    <Setter Property="BorderBrush" Value="{DynamicResource C.Seam}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Row}" />
    <Style.Triggers>
      <!--
        Наведение на строку — та же смена состояния, что у кнопки: 160 мс.
        Строка списка не орган управления, но она **отзывается**, и по
        отклику видно, к чему относятся кнопки справа. Без отклика
        человек целится в кнопку, не понимая, какой строке она
        принадлежит.
      -->
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Background.Opacity"
                               To="1"
                               Duration="{StaticResource Motion.State}"
                               EasingFunction="{StaticResource Ease.In}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Background.Opacity"
                               To="0"
                               Duration="{StaticResource Motion.State}"
                               EasingFunction="{StaticResource Ease.Out}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource C.FaceHigh}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Max}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="56" />
  </Style>
</ResourceDictionary>
