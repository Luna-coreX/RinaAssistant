<!--
  The controls. Written, not taken from a library — ADR 0005.

  A secondary button is not drawn as a box: it is flush with the panel and
  shows itself on hover. Prominence comes from the single primary button,
  filled with ink — a hierarchy without a second accent. There is one accent
  in the system, and it means "attention here", not "this is an important
  button".

  There are no shadows anywhere. Elevation is expressed by a step in value
  and a hairline seam: an instrument panel has no light source, and a shadow
  would imitate something that does not exist.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ui="clr-namespace:Rina.Shell.Styles"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The highlight brushes. Each place that needs one has its own.

    `x:Shared="False"` is mandatory: a value from a dictionary is otherwise
    one for everybody, and it is frozen — it cannot be animated, and if it
    could, the whole table would light up at once.

    Declared **at the start of the dictionary**: `StaticResource` looks for
    what is declared above, and a reference to a resource from the bottom
    half of the file fails at run time while passing the build.

    There are two brushes, because a highlight is obliged to differ from
    **what it lies on**, and they lie on different things. A list row lies
    on the raised surface (`FACE_HIGH`) and darkens to `FACE_LOW`. An opened
    list is raised too, so its option darkens to `FACE`: a step down, but a
    different one, because what is underneath is different too.

    The first edition took `FACE_HIGH` for the option — the colour of the
    surface itself. Opacity honestly travelled to one, the animation ran,
    the check went green, and nothing was visible: the highlight coincided
    with the background. Hence the check "the highlight differs from what is
    underneath" — it compares colours, not the fact of movement.
  -->
  <SolidColorBrush x:Key="Row.Warm" x:Shared="False" Opacity="0"
                   Color="{DynamicResource Color.FaceLow}" />
  <SolidColorBrush x:Key="Choice.Warm" x:Shared="False" Opacity="0"
                   Color="{DynamicResource Color.Face}" />


  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <!--
              The highlight layer over the face. What is animated is its
              opacity, not the brush's colour: brushes from the dictionary
              are shared and frozen, and animating the colour would drop the
              application on the first hover.
            -->
            <Border x:Name="Face" Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource Radius.Max}" />
            <Border x:Name="Warm" Opacity="0"
                    Background="{DynamicResource C.FaceHigh}"
                    CornerRadius="{StaticResource Radius.Max}" />
            <Border x:Name="Sunk" Opacity="0"
                    Background="{DynamicResource C.FaceLow}"
                    CornerRadius="{StaticResource Radius.Max}" />
            <Border x:Name="Ring" BorderThickness="0"
                    CornerRadius="{StaticResource Radius.Max}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Hover is a change of state: 160 ms (SYSTEM §7). -->
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Warm"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Warm"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- A press is a response: 90 ms. Faster than hover on purpose:
                 the finger has already pressed, and there is nothing to wait
                 for from the instrument. -->
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sunk"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.Press}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sunk"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.Press}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- Focus by a border, not by a background highlight: a keyboard
                 user has to see where they are without guessing whether this
                 is selected or hovered. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush"
                      Value="{DynamicResource C.Signal}" />
              <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource C.InkFaint}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The hatching of the irreversible. The only sign of danger in the system,
    and it occurs in exactly one place — which is why it always means one and
    the same thing.

    Danger is not marked by colour: colour wears out through repetition, and
    where every unpleasantness is painted red, red stops meaning "careful".
    There is no red in the palette at all.

    The angle, the thickness, the pitch and the opacity come from
    tokens.json.
  -->
  <DrawingBrush x:Key="Hatch" TileMode="Tile" Stretch="None"
                Viewport="0,0,7,7" ViewportUnits="Absolute"
                Opacity="0.2">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Pen>
          <Pen Brush="{DynamicResource C.Hatch}" Thickness="2" />
        </GeometryDrawing.Pen>
        <GeometryDrawing.Geometry>
          <LineGeometry StartPoint="0,7" EndPoint="7,0" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!--
    The button of an irreversible action. It is neither filled with the
    accent nor red: it is hatched. The second device is the gap around it,
    twice the usual one; that works for someone who cannot make out the
    pattern too.
  -->
  <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource Hatch}" />
    <Setter Property="Padding" Value="20,0" />
  </Style>

  <!-- Primary: one per screen. Filled with ink, not with the accent. -->
  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource C.Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource C.Face}" />
  </Style>

  <!-- Window controls: marks, not words. That is the system's convention. -->
  <Style x:Key="Btn.Window" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="{StaticResource Size.Row}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource C.InkFaint}" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
  </Style>

  <!-- A section in the column. The active mark is the only accent. -->
  <Style x:Key="Nav.Item" TargetType="RadioButton">
    <Setter Property="Height" Value="{StaticResource Size.Row}" />
    <Setter Property="Foreground" Value="{DynamicResource C.InkSoft}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Nav.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource Type.Nav.Weight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Row" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The hover highlight as a separate layer: a shared brush's
                 colour cannot be animated, it is frozen. -->
            <Border x:Name="Warm" Grid.ColumnSpan="2" Opacity="0"
                    Background="{DynamicResource C.FaceHigh}" />
            <Rectangle x:Name="Mark" Grid.Column="0" Fill="Transparent" />
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                              Margin="14,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Warm"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Warm"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Row" Property="Background"
                      Value="{DynamicResource C.Face}" />
              <Setter TargetName="Mark" Property="Fill"
                      Value="{DynamicResource C.Signal}" />
              <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A field: sunk, without a border. The boundary is drawn by a step in value. -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource C.FaceSunk}" />
    <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource C.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Well" Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Radius.Max}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <!-- The hint sits under the content: it goes out as soon as
                   text appears in the field, and never becomes a value. -->
              <TextBlock x:Name="Hint" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Foreground="{DynamicResource C.InkFaint}"
                         FontFamily="{StaticResource Font.Ui}"
                         FontSize="{StaticResource Type.Value.Size}"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Path=(ui:Ui.Hint),
                                RelativeSource={RelativeSource TemplatedParent}}"
                         Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Text.Length,
                           RelativeSource={RelativeSource Self}}" Value="0" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Hint" Property="Visibility"
                      Value="Visible" />
            </MultiDataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Well" Property="BorderBrush"
                      Value="{DynamicResource C.Signal}" />
              <Setter TargetName="Well" Property="BorderThickness" Value="2" />
              <Setter TargetName="Well" Property="Padding" Value="10,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The dropdown.

    It had no style of its own, and WPF drew its own: a white field with a
    blue border in the middle of a black finish. This is exactly the case
    ADR 0005 turned down somebody else's library for, in favour of our own
    styles over the standard controls — and a reminder that "a standard
    control" means "looks standard" until it is dressed.

    An unavailable option goes dim but stays: a person has to see that such
    an engine exists — otherwise they will go looking for it where we hid
    it.
  -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Row" Background="{StaticResource Choice.Warm}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <!--
              The option under the cursor is highlighted by the same motion
              as a list row: 160 ms. What used to stand here was an instant
              colour change — the one place where a state was switched
              rather than changed.

              Each option has a brush of its own (`Row.Warm`,
              `x:Shared="False"`): the shared one is frozen and cannot be
              animated.
            -->
            <Trigger Property="IsHighlighted" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Row"
                                     Storyboard.TargetProperty="Background.Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Row"
                                     Storyboard.TargetProperty="Background.Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground"
                      Value="{DynamicResource C.InkFaint}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The slider.

    It is created where the core named **both** bounds: "volume from zero to
    a hundred" is an invitation to drag rather than to type. The rule is
    general rather than a list of keys: a setting that gains bounds will get
    a slider by itself, and nobody will forget to write it in here.

    The value is always shown alongside. A slider without a number answers
    the question "roughly how much" and does not answer "exactly how much" —
    and a person who needs to set eighty is doomed to push a mouse around.
  -->
  <Style x:Key="Slide" TargetType="Slider">
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <!-- The track is sunk and what has been covered is in the accent:
                 "how much already" and "how much in all" must differ without
                 a caption. -->
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource C.FaceSunk}" />
            <Border x:Name="PART_SelectionRange" Height="4" CornerRadius="2"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource C.Signal}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge"
                              Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge"
                              Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="16" Height="16">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="Grip"
                               Fill="{DynamicResource C.Ink}" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Grip" Property="Fill"
                                  Value="{DynamicResource C.Signal}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Grip" Property="Fill"
                                  Value="{DynamicResource C.Signal}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Choice" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource C.FaceSunk}" />
    <Setter Property="Foreground" Value="{DynamicResource C.Ink}" />
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Face" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Well"
                          Background="{DynamicResource C.FaceSunk}"
                          CornerRadius="{StaticResource Radius.Max}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0" Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                      <!-- The arrow is drawn, not typed as a character: a
                           font may not contain it, and then the list would
                           look broken on somebody else's machine. -->
                      <Path Grid.Column="1" Margin="8,0,14,0"
                            VerticalAlignment="Center"
                            Data="M0,0 L8,0 L4,5 Z"
                            Fill="{DynamicResource C.InkSoft}" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Well" Property="Background"
                              Value="{DynamicResource C.FaceLow}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="Shown" IsHitTestVisible="False"
                              Margin="12,0,34,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />

            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                   Placement="Bottom" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   PopupAnimation="Fade">
              <!-- A raised surface, not a sunk one: the list lies over the
                   panel. It is also the only surface on which a dimmed
                   option is readable in both finishes (2.90 against the 3.0
                   needed on a sunk one in "silver"). -->
              <Border Background="{DynamicResource C.FaceHigh}"
                      BorderBrush="{DynamicResource C.Seam}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Tight}"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="320" Margin="0,4,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Shown" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The toggle. The on position is a mark in the accent: this is the
    "selected" state from the table in §6, not a second meaning of the
    accent.
  -->
  <Style x:Key="Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <!-- A label by a control is mandatory (direction), and its colour is
         given by the system rather than by WPF's default: otherwise it ends
         up the grey nobody chose. -->
    <Setter Property="Foreground" Value="{DynamicResource C.InkSoft}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body.Size}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <!-- A toggle switch, not a pill. A radius of 11 made a phone
                 button of it; instruments have tight corners, and the radius
                 limit is 3 (DIRECTION §2). It is also more honest this way:
                 this is a switch on a panel, not a soft icon in a list. -->
            <Grid Width="40" Height="22" VerticalAlignment="Center">
              <Border x:Name="Track"
                      CornerRadius="{StaticResource Radius.Max}"
                      Background="{DynamicResource C.FaceSunk}" />
              <!-- The on position as a separate layer over the top: a shared
                   brush's colour cannot be animated, it is frozen. -->
              <Border x:Name="On" Opacity="0"
                      CornerRadius="{StaticResource Radius.Max}"
                      Background="{DynamicResource C.Signal}" />
              <!--
                The knob travels by a shift, not by a change of alignment:
                alignment switches instantly, whereas a state in the system
                changes over 160 ms (SYSTEM §7). A toggle whose knob
                teleports reads as a picture rather than as a control.
              -->
              <Border x:Name="Knob" Width="14" Height="14"
                      CornerRadius="{StaticResource Radius.Tight}"
                      HorizontalAlignment="Left" Margin="4,0,0,0"
                      Background="{DynamicResource C.InkFaint}">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="Shift" X="0" />
                </Border.RenderTransform>
              </Border>
            </Grid>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Knob" Property="Background"
                      Value="{DynamicResource C.FaceHigh}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <!-- 40 track width − 14 knob − 4 gap on the left
                         − 4 on the right = 18 points of travel. -->
                    <DoubleAnimation Storyboard.TargetName="Shift"
                                     Storyboard.TargetProperty="X"
                                     To="18"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                    <DoubleAnimation Storyboard.TargetName="On"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.In}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shift"
                                     Storyboard.TargetProperty="X"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                    <DoubleAnimation Storyboard.TargetName="On"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.State}"
                                     EasingFunction="{StaticResource Ease.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The glass field: the instrument's only glowing surface. -->
  <Style x:Key="Glass" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource C.Glass}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Max}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!--
    The scrollbar. Our own, because the stock one brings Windows' palette
    onto a panel that has its own — and in the black finish a light grey bar
    is seen first, before the contents.

    Without arrows: they belong to another era and take up room while adding
    nothing. The thumb is a step in value, like all elevation in the system.
  -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="{DynamicResource C.InkFaint}"
                  CornerRadius="{StaticResource Radius.Max}" Opacity="0.5" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" />
            </Track.Thumb>
            <!-- The page buttons are obliged to exist, but there is no need
                 for them to be visible: the bar is the control. -->
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand"
                            Opacity="0" Focusable="False" />
            </Track.IncreaseRepeatButton>
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand"
                            Opacity="0" Focusable="False" />
            </Track.DecreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    A list block: one raised step for the whole list.

    Not a stack of cards: "a window is a front panel, not a set of cards on a
    background" (DIRECTION §3). The rows of a list are parts of one object,
    and a gap between them would turn them into five objects.
  -->
  <Style x:Key="Rows" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource C.FaceHigh}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Max}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!--
    A row inside a block. Separated from its neighbour by a hairline seam —
    the same device as the areas of the panel, and never by a shadow.
  -->
  <Style x:Key="Rows.Item" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Row.Warm}" />
    <Setter Property="BorderBrush" Value="{DynamicResource C.Seam}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="{StaticResource Size.Row}" />
    <Style.Triggers>
      <!--
        Hovering over a row is the same change of state as a button's: 160
        ms. A list row is not a control, but it **responds**, and the
        response shows what the buttons on the right belong to. Without a
        response a person aims at a button without understanding which row it
        belongs to.
      -->
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Background.Opacity"
                               To="1"
                               Duration="{StaticResource Motion.State}"
                               EasingFunction="{StaticResource Ease.In}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Background.Opacity"
                               To="0"
                               Duration="{StaticResource Motion.State}"
                               EasingFunction="{StaticResource Ease.Out}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A card: raised by a step in value, without a border and without a shadow. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource C.FaceHigh}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Max}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="56" />
  </Style>
</ResourceDictionary>
