<Project>
  <!--
    Общие свойства всех проектов оболочки.

    TreatWarningsAsErrors — не строгость ради строгости: оболочка пишется
    с нуля, и предупреждение, которое сегодня «потом посмотрим», через месяц
    станет одним из трёхсот.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>ru</NeutralLanguage>
    <!-- Версия оболочки. Одна из четырёх независимых (ADR 0004) и живёт
         здесь, а не строкой в коде: «О программе» читает её из сборки, и
         второй источник разошёлся бы с первым на первом же выпуске. -->
    <Version>4.0.0</Version>
  </PropertyGroup>
</Project>
