{
  "format": 1,
  "direction": "Аппарат",
  "note": "Токены дизайн-системы 4.0 (задача 4.0-R03). Машиночитаемые, потому что по ним пишется XAML оболочки и проверяются макеты: одно значение в одном месте. Две отделки — не режимы: аппаратура выпускалась в серебре и в чёрном, обе первого класса.",

  "finishes": {
    "silver": {
      "title": "Серебро",
      "color": {
        "FACE":        "#d7d4cd",
        "FACE_HIGH":   "#e6e3dc",
        "FACE_LOW":    "#c8c5bd",
        "FACE_SUNK":   "#b9b6ad",
        "SEAM":        "#a8a49a",
        "GLASS":       "#191a1c",
        "GLASS_TEXT":  "#e8e6e1",
        "GLASS_DIM":   "#9a9892",
        "INK":         "#26251f",
        "INK_SOFT":    "#5c584f",
        "INK_FAINT":   "#767268",
        "SIGNAL":      "#b8451a",
        "SIGNAL_SUNK": "#93370f",
        "HATCH":       "#26251f"
      }
    },
    "black": {
      "title": "Чёрное",
      "color": {
        "FACE":        "#1f1e1c",
        "FACE_HIGH":   "#2a2926",
        "FACE_LOW":    "#161513",
        "FACE_SUNK":   "#101010",
        "SEAM":        "#3a3730",
        "GLASS":       "#0b0c0d",
        "GLASS_TEXT":  "#e8e6e1",
        "GLASS_DIM":   "#8b8981",
        "INK":         "#d6d2c8",
        "INK_SOFT":    "#9a9589",
        "INK_FAINT":   "#726d64",
        "SIGNAL":      "#e8631f",
        "SIGNAL_SUNK": "#c9521a",
        "HATCH":       "#d6d2c8"
      }
    }
  },

  "typography": {
    "family": {
      "ui": "Segoe UI Variable",
      "mono": "Cascadia Mono"
    },
    "role": {
      "legend":  {"family": "ui",   "size": 11, "weight": 600, "tracking": 0.08, "case": "upper", "color": "INK_SOFT"},
      "body":    {"family": "ui",   "size": 13, "weight": 400, "tracking": 0,    "color": "INK"},
      "value":   {"family": "ui",   "size": 14, "weight": 400, "tracking": 0,    "color": "INK"},
      "section": {"family": "ui",   "size": 12, "weight": 700, "tracking": 0.06, "case": "upper", "color": "INK"},
      "figure":  {"family": "mono", "size": 13, "weight": 400, "tracking": 0,    "color": "INK", "tabular": true},
      "speech":  {"family": "ui",   "size": 14, "weight": 400, "leading": 1.5,   "color": "GLASS_TEXT"},
      "meta":    {"family": "ui",   "size": 11, "weight": 400, "tracking": 0,    "color": "INK_SOFT"}
    }
  },

  "space": {
    "hair": 1,
    "tight": 4,
    "inner": 8,
    "within": 12,
    "between": 24,
    "danger": 48
  },

  "radius": {
    "none": 0,
    "tight": 2,
    "max": 3
  },

  "size": {
    "row": 36,
    "control": 32,
    "legend_column": 148,
    "level_strip": 6,
    "seam": 1
  },

  "motion": {
    "instant": 0,
    "press": 90,
    "state": 160,
    "panel": 220,
    "afterglow": 1000,
    "easing": {
      "default": "cubic-bezier(0.2, 0, 0, 1)",
      "decay": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },

  "states": {
    "note": "Состояния выражаются ступенью значения и швом, никогда тенью или размытием.",
    "rest":     {"surface": "FACE",       "ink": "INK"},
    "hover":    {"surface": "FACE_HIGH",  "ink": "INK"},
    "press":    {"surface": "FACE_LOW",   "ink": "INK"},
    "focus":    {"surface": "FACE",       "ink": "INK",       "outline": "SIGNAL", "outline_width": 2},
    "selected": {"surface": "FACE_HIGH",  "ink": "INK",       "marker": "SIGNAL"},
    "disabled": {"surface": "FACE",       "ink": "INK_FAINT"},
    "error":    {"surface": "FACE",       "ink": "SIGNAL"},
    "danger":   {"surface": "FACE",       "ink": "INK",       "hatch": true}
  },

  "hatch": {
    "note": "Единственный признак необратимого действия. Встречается ровно в одном месте, поэтому всегда значит одно и то же.",
    "angle": 45,
    "line": 2,
    "gap": 6,
    "color": "HATCH",
    "opacity": 0.22
  }
}
